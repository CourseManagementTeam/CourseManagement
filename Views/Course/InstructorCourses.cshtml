@model IEnumerable<CourseManagementSystem.Models.Course>

@{
    ViewData["Title"] = "My Teaching Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-bold mb-1" style="color:var(--text);">Instructor Dashboard</h1>
            <p class="text-muted mb-0">Manage and optimize your published educational content.</p>
        </div>
        <a asp-action="Create" class="btn-primary-learnly">+ Create New Course</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-journal-plus" style="font-size:3.5rem;color:var(--primary);opacity:.4;"></i>
            <h4 class="mt-3" style="color:var(--text);">No courses yet</h4>
            <p class="text-muted">Create your first course to get started.</p>
            <a asp-action="Create" class="btn-primary-learnly">Create a Course</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm" style="background: var(--card-bg); border-radius: 16px; overflow: hidden;">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr style="background: var(--bg-soft); color:var(--text);">
                            <th class="border-0 px-4 py-3" style="color:var(--text-muted);font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Course</th>
                            <th class="border-0 py-3" style="color:var(--text-muted);font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Category</th>
                            <th class="border-0 py-3" style="color:var(--text-muted);font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Price</th>
                            <th class="border-0 py-3" style="color:var(--text-muted);font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Rating</th>
                            <th class="border-0 px-4 py-3 text-end" style="color:var(--text-muted);font-size:.82rem;font-weight:600;text-transform:uppercase;letter-spacing:.04em;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-color:var(--border);">
                                <td class="px-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/Courses/default.avif" : "/images/Courses/" + item.ImageUrl)"
                                             class="rounded-2"
                                             style="width: 64px; height: 42px; object-fit: cover; flex-shrink:0;"
                                             onerror="this.src='/images/Courses/default.avif'" />
                                        <div>
                                            <h6 class="fw-bold mb-0" style="color:var(--text);">@item.Title</h6>
                                            <small class="text-muted">Added: @item.CreatedDate.ToString("dd MMM yyyy")</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge px-2 py-1 rounded" style="background: var(--bg-soft); color: var(--primary); border:1px solid var(--border);">@item.Category?.Name</span>
                                </td>
                                <td class="fw-bold" style="color:var(--text);">
                                    @(item.Price == 0 ? "Free" : item.Price.ToString("C", new System.Globalization.CultureInfo("en-US")))
                                </td>
                                <td style="color:var(--text);">
                                    <i class="bi bi-star-fill text-warning me-1"></i>@item.AverageRating.ToString("0.0")
                                </td>
                                <td class="px-4 text-end">
                                    <a asp-controller="Section" asp-action="Index" asp-route-courseId="@item.Id"
                                       class="btn btn-sm btn-primary px-3 me-1" title="Manage Curriculum">
                                        <i class="bi bi-list-ul me-1"></i> Curriculum
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-learnly me-1" title="Preview">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning px-3 me-1" title="Edit">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger px-3" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>