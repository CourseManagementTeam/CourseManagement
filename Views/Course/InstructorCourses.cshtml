@model IEnumerable<CourseManagementSystem.Models.Course>

@{
    ViewData["Title"] = "My Teaching Dashboard";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-extrabold">Instructor Dashboard</h1>
            <p class="text-muted mb-0">Manage and optimize your published educational content.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary-learnly">+ Create New Course</a>
    </div>

    <div class="card border-0 shadow-sm" style="background: var(--card-bg); border-radius: 16px; overflow: hidden;">
        <div class="table-responsive">
            <table class="table align-middle mb-0 text-nowrap" style="color: var(--text);">
                <thead class="table-light" style="background: var(--bg-soft);">
                    <tr>
                        <th class="border-0 px-4 py-3">Course Title</th>
                        <th class="border-0 py-3">Category</th>
                        <th class="border-0 py-3">Price</th>
                        <th class="border-0 py-3">Rating</th>
                        <th class="border-0 px-4 py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="px-4 py-3.5">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/courses/default.jpg" : $"/images/courses/{item.ImageUrl}")" class="rounded-2" style="width: 64px; height: 42px; object-fit: cover;" />
                                    <div>
                                        <h6 class="fw-bold mb-0">@item.Title</h6>
                                        <small class="text-muted">Added: @item.CreatedDate.ToString("dd MMM yyyy")</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge px-2.5 py-1.5 rounded" style="background: var(--bg-soft); color: var(--primary);">@item.Category?.Name</span></td>
                            <td class="fw-bold"> @item.Price.ToString("C", new System.Globalization.CultureInfo("en-US"))</td>
                            <td><i class="bi bi-star-fill text-warning me-1"></i>@item.AverageRating.ToString("0.0")</td>
                            <td class="px-4 text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-learnly me-1" title="Preview"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning btn-sm px-3 me-1" title="Edit"><i class="bi bi-pencil-square"></i> Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger btn-sm px-3" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
