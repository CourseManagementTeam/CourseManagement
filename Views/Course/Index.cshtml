@model IEnumerable<CourseManagementSystem.ViewModels.CourseListVM>

@{
    ViewData["Title"] = "All Courses";
}

<div class="py-5" style="background: var(--bg-soft); border-bottom: 1px solid var(--border);">
    <div class="container">
        <h1 class="fw-bold mb-2" style="color:var(--text);">Explore Courses</h1>
        <p class="text-muted fs-5">Find the perfect course to advance your professional career.</p>
        <form method="get" asp-action="Index" class="row g-3 mt-4">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" name="search" value="@ViewBag.Search" placeholder="@Localizer["Search.Placeholder"]" class="w-100" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select" style="background: var(--card-bg); color: var(--text); height: 42px; border-radius: 10px; border-color: var(--border);">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn-primary-learnly w-100" style="height: 42px; display:flex; align-items:center; justify-content:center;">Search</button>
            </div>
        </form>
    </div>
</div>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-circle" style="font-size: 3rem; color: var(--text-muted);"></i>
            <h3 class="mt-3" style="color:var(--text);">No courses found</h3>
            <p class="text-muted">Try adjusting your search criteria or filter options.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm course-card" style="background: var(--card-bg); border-radius: 16px; overflow: hidden;">
                        <div class="position-relative" style="height:160px;overflow:hidden;">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/Courses/default.avif" : "/images/Courses/" + item.ImageUrl)"
                                 class="card-img-top w-100 h-100"
                                 style="object-fit: cover; transition: transform .4s ease;"
                                 alt="@item.Title"
                                 onerror="this.src='/images/Courses/default.avif'" />
                            <span class="position-absolute top-0 start-0 m-2 badge px-2 py-1"
                                  style="background:rgba(0,0,0,.55);color:#fff;font-size:.72rem;border-radius:6px;backdrop-filter:blur(4px);">
                                @item.CategoryName
                            </span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold mb-1" style="font-size: .95rem; line-height: 1.4; min-height: 2.8rem; color:var(--text); overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
                                @item.Title
                            </h5>
                            <p class="mb-2" style="font-size: 0.82rem; color:var(--text-muted);">
                                <i class="bi bi-person-circle me-1"></i>@item.InstructorName
                            </p>

                            <div class="d-flex align-items-center gap-1 mb-3" style="font-size: 0.85rem;">
                                <span style="color:#f59e0b; font-weight:700;">★ @item.AverageRating.ToString("0.0")</span>
                            </div>

                            <div class="mt-auto d-flex align-items-center justify-content-between pt-2" style="border-top: 1px solid var(--border);">
                                <span class="fw-bold" style="color: var(--primary); font-size:1.05rem;">
                                    @(item.Price == 0 ? "Free" : item.Price.ToString("C", new System.Globalization.CultureInfo("en-US")))
                                </span>
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm fw-semibold"
                                   style="background:transparent;border:1.5px solid var(--primary);color:var(--primary);border-radius:8px;padding:.3rem .75rem;font-size:.82rem;">
                                    View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .course-card { transition: transform .22s, box-shadow .22s; }
    .course-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px -8px rgba(109,40,217,.28) !important; }
    .course-card:hover img { transform: scale(1.04); }
</style>