@model IEnumerable<CourseManagementSystem.ViewModels.CourseListVM>

@{
    ViewData["Title"] = "All Courses";
}

<div class="py-5" style="background: var(--bg-soft); border-bottom: 1px solid var(--border);">
    <div class="container">
        <h1 class="fw-extrabold mb-2">Explore Courses</h1>
        <p class="text-muted fs-5">Find the perfect course to advance your professional career.</p>
        <form method="get" asp-action="Index" class="row g-3 mt-4">
            <div class="col-md-6">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="search" name="search" value="@ViewBag.Search" placeholder="Type course title here (e.g. C#)..." class="w-100" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select border-0 px-3 py-2 shadow-sm" style="background: var(--card-bg); color: var(--text); height: 42px; border-radius: 10px;">
                    <option value="">All Categories (Show Everything)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary-learnly w-100 h-100" style="height: 42px !important;">Search</button>
            </div>
        </form>
    </div>
</div>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-exclamation-circle text-muted" style="font-size: 3rem;"></i>
            <h3 class="mt-3">No courses found</h3>
            <p class="text-muted">Try adjusting your search criteria or filter options.</p>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm" style="background: var(--card-bg); border-radius: 16px; overflow: hidden; transition: transform 0.2s;">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/courses/default.jpg" : $"/images/courses/{item.ImageUrl}")" class="card-img-top" style="height: 160px; object-fit: cover;" alt="@item.Title" />
                            <span class="position-absolute top-3 start-3 badge bg-dark bg-opacity-75 rounded-pill px-3 py-2 text-white style="font-size: 0.75rem;">@item.CategoryName</span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title fw-bold text-truncate-2 mb-1" style="font-size: 1rem; line-height: 1.4; min-height: 2.8rem;">
                                <a asp-action="Details" asp-route-id="@item.Id" style="color: var(--text);">@item.Title</a>
                            </h5>
                            <p class="text-muted mb-2" style="font-size: 0.85rem;">By @item.InstructorName</p>
                            
                            <div class="d-flex align-items-center gap-1 text-warning mb-3" style="font-size: 0.88rem;">
                                <span class="fw-bold me-1 text-muted">@item.AverageRating.ToString("0.0")</span>
                                <i class="bi bi-star-fill"></i>
                            </div>

                            <div class="mt-auto d-flex align-items-center justify-content-between pt-2" style="border-top: 1px solid var(--border);">
                                <span class="fw-extrabold fs-5" style="color: var(--primary);">@item.Price.ToString("C")</span>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill">View Info</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
