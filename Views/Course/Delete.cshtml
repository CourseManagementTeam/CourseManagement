@model CourseManagementSystem.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="container py-5" style="max-width: 600px;">
    <div class="card border-0 shadow-lg p-4 p-md-5 text-center" style="background: var(--card-bg); border-radius: 20px;">
        <div class="text-danger mb-3">
            <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
        </div>
        <h2 class="fw-extrabold text-danger mb-2">Delete This Course?</h2>
        <p class="text-muted mb-4">Are you completely sure you want to permanently delete this course? This step cannot be rolled back.</p>

        <div class="p-3 mb-4 rounded-3 text-start" style="background: var(--bg-soft); border: 1px solid var(--border);">
            <h6 class="fw-bold mb-1" style="color: var(--text);">@Model.Title</h6>
            <small class="text-muted">Category: @Model.Category?.Name</small>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger py-2.5 rounded-3 fw-bold">Yes, Delete Permanently</button>
                <a asp-action="InstructorCourses" class="btn btn-outline-learnly py-2 rounded-3">Cancel and Go Back</a>
            </div>
        </form>
    </div>
</div>