@model CourseManagementSystem.ViewModels.EditCourseVM

@{
    ViewData["Title"] = "Edit Course";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="card border-0 shadow-sm p-4 p-md-5" style="background: var(--card-bg); border-radius: 20px;">
        <h2 class="fw-extrabold mb-4"><i class="bi bi-pencil-square text-warning me-2"></i>Modify Course Info</h2>
        <hr class="mb-4" style="border-color: var(--border);" />

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingImage" />

            <div class="row g-4">
                <div class="col-100">
                    <label class="form-label fw-bold">Course Title</label>
                    <input asp-for="Title" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); padding: 0.7rem 1rem; border-radius: 10px;" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Category</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); height: 48px; border-radius: 10px;"></select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Difficulty Level</label>
                    <select asp-for="Level" class="form-select" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); height: 48px; border-radius: 10px;">
                        <option value="Beginner">Beginner Level</option>
                        <option value="Intermediate">Intermediate Level</option>
                        <option value="Advanced">Advanced Level</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); padding: 0.7rem 1rem; border-radius: 10px;" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Replace Cover Image</label>
                    <input asp-for="ImageFile" type="file" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); padding: 0.65rem 1rem; border-radius: 10px;" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.ExistingImage))
                    {
                        <div class="mt-2 text-xs text-muted">Current image: <span class="fw-bold text-primary">@Model.ExistingImage</span></div>
                    }
                </div>

                <div class="col-100">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" rows="5" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); border-radius: 10px;"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-5">
                <a asp-action="InstructorCourses" class="btn btn-outline-learnly px-4 py-2">Cancel</a>
                <button type="submit" class="btn btn-primary-learnly px-5 py-2">Update Course</button>
            </div>
        </form>
    </div>
</div>
