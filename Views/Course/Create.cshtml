@model CourseManagementSystem.ViewModels.CreateCourseVM

@{
    ViewData["Title"] = "Create Course";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="card border-0 shadow-sm p-4 p-md-5" style="background: var(--card-bg); border-radius: 20px;">
        <h2 class="fw-extrabold mb-4"><i class="bi bi-plus-circle-fill text-primary me-2" style="color: var(--primary);"></i>Add New Course</h2>
        <hr class="mb-4" style="border-color: var(--border);" />

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div class="row g-4">
                <div class="col-100">
                    <label class="form-label fw-bold">Course Title</label>
                    <input asp-for="Title" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); padding: 0.7rem 1rem; border-radius: 10px;" placeholder="e.g., Ultimate ASP.NET Core MVC Guide" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Category</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); height: 48px; border-radius: 10px;">
                        <option value="">Select Category</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Difficulty Level</label>
                    <select asp-for="Level" class="form-select" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); height: 48px; border-radius: 10px;">
                        <option value="Beginner">Beginner Level</option>
                        <option value="Intermediate">Intermediate Level</option>
                        <option value="Advanced">Advanced Level</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Price ($)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); padding: 0.7rem 1rem; border-radius: 10px;" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Course Thumbnail Cover</label>
                    <input asp-for="ImageFile" type="file" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); padding: 0.65rem 1rem; border-radius: 10px;" accept="image/*" />
                </div>

                <div class="col-100">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" rows="5" class="form-control" style="background: var(--bg-soft); color: var(--text); border-color: var(--border); border-radius: 10px;" placeholder="Write a fascinating briefing about the course..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-end mt-5">
                <a asp-action="InstructorCourses" class="btn btn-outline-learnly px-4 py-2">Cancel</a>
                <button type="submit" class="btn btn-primary-learnly px-5 py-2">Publish Course</button>
            </div>
        </form>
    </div>
</div>