@model CourseManagementSystem.ViewModels.CourseDetailsFullVM

@{
    ViewData["Title"] = Model.Title;
    bool isStudent    = User.IsInRole("Student");
    bool isInstructor = User.IsInRole("Instructor");
    bool isAdmin      = User.IsInRole("Admin");
    bool isAuth       = User.Identity?.IsAuthenticated == true;
}

@* ═══════════════════════════════════════════════════════════
   1. HERO
═══════════════════════════════════════════════════════════ *@
<div class="py-5 text-white" style="background: var(--gradient-hero);">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <a asp-controller="Category" asp-action="Details" asp-route-id="@Model.CategoryId"
                   class="badge mb-3 text-decoration-none px-3 py-2 rounded-pill fw-bold"
                   style="background:var(--secondary); color:#1e1b4b;">@Model.CategoryName</a>

                <h1 class="display-6 fw-bold mb-3">@Model.Title</h1>
                <p class="lead opacity-90 mb-4" style="max-width:680px;">@Model.Description</p>

                <div class="d-flex flex-wrap gap-3 opacity-90" style="font-size:.9rem;">
                    <span><i class="bi bi-person-circle me-1"></i> @Model.Instructor.FullName</span>
                    <span><i class="bi bi-star-fill text-warning me-1"></i> @Model.AverageRating.ToString("0.0") (@Model.ReviewsCount reviews)</span>
                    <span><i class="bi bi-people me-1"></i> @Model.StudentCount students</span>
                    <span><i class="bi bi-layers me-1"></i> @Model.Sections.Count sections · @Model.TotalLessons lessons</span>
                    @if (!string.IsNullOrEmpty(Model.Level))
                    {
                        <span><i class="bi bi-bar-chart me-1"></i> @Model.Level</span>
                    }
                    @if (Model.TotalHours > 0)
                    {
                        <span><i class="bi bi-clock me-1"></i> @Model.TotalHours hrs total</span>
                    }
                </div>
            </div>

            @* ── Purchase Card ── *@
            <div class="col-lg-4">
                <div class="card border-0 shadow-lg position-sticky" style="background:var(--card-bg); border-radius:20px; top:90px; overflow:hidden;">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/Courses/default.avif" : "/images/Courses/" + Model.ImageUrl)"
                         class="w-100" style="height:200px; object-fit:cover;"
                         onerror="this.src='/images/Courses/default.avif'" />
                    <div class="p-4">
                        <div class="fw-bold mb-3" style="font-size:1.9rem; color:var(--text);">
                            @(Model.Price == 0 ? "Free" : Model.Price.ToString("C", new System.Globalization.CultureInfo("en-US")))
                        </div>

                        @if (isStudent && Model.IsEnrolled)
                        {
                            <div class="alert alert-success py-2 mb-3" style="font-size:.85rem;">
                                <i class="bi bi-check-circle-fill me-1"></i> You are enrolled
                            </div>
                            <a asp-controller="Course" asp-action="Index"
                               class="btn-primary-learnly w-100 py-2 d-block text-center mb-2" style="border-radius:10px; font-size:1rem;">
                                <i class="bi bi-play-circle-fill me-1"></i> Continue Learning
                            </a>
                        }
                        else if (isStudent)
                        {
                            <a asp-controller="Course" asp-action="BuyNow" asp-route-id="@Model.Id"
                               class="btn-primary-learnly w-100 py-2 d-block text-center mb-2" style="border-radius:10px; font-size:1rem;">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Buy Now
                            </a>
                            @if (Model.IsInCart)
                            {
                                <a asp-controller="Cart" asp-action="Index"
                                   class="btn-outline-learnly w-100 py-2 d-block text-center mb-2" style="border-radius:10px;">
                                    <i class="bi bi-cart-check-fill me-1"></i> View Cart
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Course" asp-action="AddToCart" asp-route-id="@Model.Id"
                                   class="btn-outline-learnly w-100 py-2 d-block text-center mb-2" style="border-radius:10px;">
                                    <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                </a>
                            }
                            <a asp-controller="Wishlist" asp-action="Toggle" asp-route-id="@Model.Id"
                               class="btn w-100 py-2 mb-3" style="border-radius:10px; border:1px solid var(--primary); color:var(--primary); background:transparent;">
                                @if (Model.IsInWishlist)
                                {
                                    <i class="bi bi-heart-fill text-danger me-1"></i><text>Remove from Wishlist</text>
                                }
                                else
                                {
                                    <i class="bi bi-heart me-1"></i><text>Add to Wishlist</text>
                                }
                            </a>
                            <small class="text-muted d-block text-center">
                                <i class="bi bi-shield-check me-1"></i> 30-Day Money-Back Guarantee
                            </small>
                        }
                        else if (!isAuth)
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path"
                               class="btn-primary-learnly w-100 py-2 d-block text-center mb-2" style="border-radius:10px; font-size:1rem;">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Log In to Enroll
                            </a>
                            <small class="text-muted d-block text-center">Free to browse — log in to purchase</small>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Instructor / Admin management bar ── *@
@{
    var currentUserId  = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool ownsThisCourse = isInstructor && currentUserId == Model.Instructor.Id;
}
@if (ownsThisCourse || isAdmin)
{
    <div class="border-bottom py-2" style="background:var(--card-bg);">
        <div class="container d-flex align-items-center gap-2 flex-wrap">
            <span class="text-muted me-2" style="font-size:.82rem;">
                <i class="bi bi-pencil-square me-1"></i>
                @(isAdmin ? "Admin" : "Instructor") view
            </span>
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-sm btn-warning px-3">
                <i class="bi bi-pencil me-1"></i>Edit Course
            </a>
            <a asp-controller="Section" asp-action="Index" asp-route-courseId="@Model.Id"
               class="btn btn-sm btn-primary px-3">
                <i class="bi bi-list-ul me-1"></i>Curriculum
            </a>
            @if (isAdmin)
            {
                <form asp-controller="Admin" asp-action="DeleteCourse" asp-route-id="@Model.Id"
                      method="post" class="d-inline ms-auto"
                      onsubmit="return confirm('Permanently delete this course and all its data?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger px-3">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            }
        </div>
    </div>
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-8">

            @* ═══════════════════════════════════════════════════════════
               2. WHAT YOU'LL LEARN
            ═══════════════════════════════════════════════════════════ *@
            @if (Model.LearnItems.Any())
            {
                <section class="mb-5 p-4 rounded-4" style="background:var(--card-bg); border:1px solid var(--border);">
                    <h3 class="fw-bold mb-4" style="color:var(--text); font-size:1.25rem;">
                        <i class="bi bi-lightbulb-fill me-2" style="color:var(--primary);"></i>What You'll Learn
                    </h3>
                    <div class="row g-2">
                        @foreach (var item in Model.LearnItems)
                        {
                            <div class="col-md-6 d-flex gap-2">
                                <i class="bi bi-check-circle-fill flex-shrink-0 mt-1" style="color:#10b981;"></i>
                                <span style="color:var(--text); font-size:.93rem;">@item</span>
                            </div>
                        }
                    </div>
                </section>
            }

            @* ═══════════════════════════════════════════════════════════
               3. INSTRUCTOR CARD
            ═══════════════════════════════════════════════════════════ *@
            <section class="mb-5">
                <h3 class="fw-bold mb-4" style="color:var(--text); font-size:1.25rem;">
                    <i class="bi bi-person-badge me-2" style="color:var(--primary);"></i>Your Instructor
                </h3>
                <div class="card border-0 shadow-sm p-4" style="background:var(--card-bg); border-radius:16px;">
                    <div class="d-flex gap-4 align-items-start">
                        @if (!string.IsNullOrEmpty(Model.Instructor.ProfileImage))
                        {
                            <img src="@Model.Instructor.ProfileImage" class="rounded-circle flex-shrink-0"
                                 style="width:70px; height:70px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="avatar flex-shrink-0"
                                 style="width:70px; height:70px; font-size:1.6rem; border-radius:50%;">
                                @Model.Instructor.FullName.Substring(0, 1).ToUpper()
                            </div>
                        }
                        <div>
                            <h5 class="fw-bold mb-1" style="color:var(--text);">@Model.Instructor.FullName</h5>
                            <div class="d-flex gap-3 mb-2" style="font-size:.85rem; color:#6b7280;">
                                <span><i class="bi bi-journal-bookmark me-1"></i>@Model.Instructor.TotalCourses courses</span>
                                <span><i class="bi bi-people me-1"></i>@Model.Instructor.TotalStudents students</span>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Instructor.Bio))
                            {
                                <p class="mb-0" style="color:var(--text); font-size:.93rem; line-height:1.7;">@Model.Instructor.Bio</p>
                            }
                        </div>
                    </div>
                </div>
            </section>

            @* ═══════════════════════════════════════════════════════════
               4. CURRICULUM ACCORDION
            ═══════════════════════════════════════════════════════════ *@
            <section class="mb-5">
                <h3 class="fw-bold mb-2" style="color:var(--text); font-size:1.25rem;">
                    <i class="bi bi-list-ul me-2" style="color:var(--primary);"></i>Course Curriculum
                </h3>
                <p class="text-muted mb-4" style="font-size:.88rem;">
                    @Model.Sections.Count sections · @Model.TotalLessons lessons ·
                    @(Model.TotalDurationMinutes >= 60
                        ? $"{Model.TotalDurationMinutes / 60}h {Model.TotalDurationMinutes % 60}m"
                        : $"{Model.TotalDurationMinutes}m") total length
                </p>

                @if (!Model.Sections.Any())
                {
                    <div class="text-muted text-center py-4">
                        <i class="bi bi-collection" style="font-size:2rem;"></i>
                        <p class="mt-2 mb-0">Curriculum coming soon.</p>
                    </div>
                }
                else
                {
                    <div class="accordion border rounded-4 overflow-hidden" id="curriculumAccordion"
                         style="border-color:var(--border)!important;">
                        @foreach (var sec in Model.Sections)
                        {
                            var collapseId = $"section-{sec.Id}";
                            var headingId  = $"heading-{sec.Id}";
                            bool isFirst   = sec.OrderNumber == Model.Sections.Min(s => s.OrderNumber);

                            <div class="accordion-item border-0" style="border-bottom:1px solid var(--border)!important; background:var(--card-bg);">
                                <h2 class="accordion-header" id="@headingId">
                                    <button class="accordion-button @(isFirst ? "" : "collapsed") fw-semibold"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#@collapseId"
                                            aria-expanded="@(isFirst ? "true" : "false")"
                                            aria-controls="@collapseId"
                                            style="background:var(--card-bg); color:var(--text); font-size:.95rem;">
                                        <span class="me-2" style="font-size:.8rem; color:#6b7280; font-weight:400;">
                                            Section @sec.OrderNumber
                                        </span>
                                        @sec.Title
                                        <span class="ms-auto me-3 fw-normal text-muted" style="font-size:.8rem; white-space:nowrap;">
                                            @sec.LessonCount lesson@(sec.LessonCount == 1 ? "" : "s")
                                            @if (sec.TotalDurationMinutes > 0)
                                            {
                                                <text> · @(sec.TotalDurationMinutes >= 60
                                                    ? $"{sec.TotalDurationMinutes / 60}h {sec.TotalDurationMinutes % 60}m"
                                                    : $"{sec.TotalDurationMinutes}m")</text>
                                            }
                                        </span>
                                    </button>
                                </h2>
                                <div id="@collapseId"
                                     class="accordion-collapse collapse @(isFirst ? "show" : "")"
                                     aria-labelledby="@headingId"
                                     data-bs-parent="#curriculumAccordion">
                                    <div class="accordion-body p-0">
                                        @foreach (var lesson in sec.Lessons)
                                        {
                                            bool canAccess = lesson.IsFreePreview || (isStudent && Model.IsEnrolled) || isInstructor || isAdmin;

                                            <div class="d-flex align-items-start gap-3 px-4 py-3"
                                                 style="border-top:1px solid var(--border); font-size:.9rem;">
                                                @* Icon *@
                                                <div class="flex-shrink-0 mt-1">
                                                    @if (!canAccess)
                                                    {
                                                        <i class="bi bi-lock-fill text-muted"></i>
                                                    }
                                                    else if (lesson.HasVideo)
                                                    {
                                                        <i class="bi bi-play-circle-fill" style="color:var(--primary);"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-file-text" style="color:var(--primary);"></i>
                                                    }
                                                </div>

                                                @* Title + badges *@
                                                <div class="flex-grow-1">
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span style="color:var(--text);">@lesson.Title</span>
                                                        @if (lesson.IsFreePreview)
                                                        {
                                                            <span class="badge" style="background:#dcfce7; color:#166534; font-size:.7rem;">Free Preview</span>
                                                        }
                                                    </div>

                                                    @* Lesson content: only when accessible *@
                                                    @if (canAccess)
                                                    {
                                                        @* Video *@
                                                        @if (!string.IsNullOrEmpty(lesson.EmbedUrl) && lesson.VideoType == "youtube")
                                                        {
                                                            <div class="mt-2 ratio ratio-16x9" style="max-width:560px; border-radius:10px; overflow:hidden;">
                                                                <iframe src="@lesson.EmbedUrl" allowfullscreen
                                                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                                                </iframe>
                                                            </div>
                                                        }
                                                        else if (lesson.VideoType == "upload" && !string.IsNullOrEmpty(lesson.UploadedVideoFileName))
                                                        {
                                                            <video class="mt-2 w-100 rounded-3" style="max-width:560px;" controls>
                                                                <source src="/uploads/videos/@lesson.UploadedVideoFileName" />
                                                                Your browser does not support the video tag.
                                                            </video>
                                                        }

                                                        @* Attachments *@
                                                        @if (lesson.Attachments.Any())
                                                        {
                                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                                @foreach (var att in lesson.Attachments)
                                                                {
                                                                    <a href="/uploads/attachments/@att.FileName"
                                                                       download="@att.FileName"
                                                                       class="badge text-decoration-none d-flex align-items-center gap-1 px-2 py-1"
                                                                       style="background:var(--bg); border:1px solid var(--border); color:var(--text); font-size:.78rem; border-radius:6px;">
                                                                        <i class="bi @att.FileIcon" style="font-size:.9rem;"></i>
                                                                        @att.FileName
                                                                        <span class="text-muted ms-1">(@att.FileSizeDisplay)</span>
                                                                    </a>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                    else if (!isAuth)
                                                    {
                                                        <div class="mt-1" style="font-size:.8rem; color:#6b7280;">
                                                            <a asp-controller="Account" asp-action="Login"
                                                               asp-route-returnUrl="@Context.Request.Path"
                                                               style="color:var(--primary);">Log in</a> to access this lesson
                                                        </div>
                                                    }
                                                    else if (isStudent && !Model.IsEnrolled)
                                                    {
                                                        <div class="mt-1" style="font-size:.8rem; color:#6b7280;">
                                                            Enroll to unlock this lesson
                                                        </div>
                                                    }
                                                </div>

                                                @* Duration *@
                                                @if (lesson.DurationMinutes > 0)
                                                {
                                                    <span class="flex-shrink-0 text-muted" style="font-size:.8rem; white-space:nowrap;">
                                                        @(lesson.DurationMinutes >= 60
                                                            ? $"{lesson.DurationMinutes / 60}h {lesson.DurationMinutes % 60}m"
                                                            : $"{lesson.DurationMinutes}m")
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            @* ═══════════════════════════════════════════════════════════
               5. REVIEWS
            ═══════════════════════════════════════════════════════════ *@
            <section class="mb-5">
                <h3 class="fw-bold mb-4" style="color:var(--text); font-size:1.25rem;">
                    <i class="bi bi-star-fill me-2" style="color:#f59e0b;"></i>Student Reviews
                </h3>

                @if (Model.Reviews.Any())
                {
                    <div class="d-flex align-items-center gap-4 mb-4 p-4 rounded-4"
                         style="background:var(--card-bg); border:1px solid var(--border);">
                        <div class="text-center flex-shrink-0">
                            <div style="font-size:3rem; font-weight:800; color:var(--text); line-height:1;">
                                @Model.AverageRating.ToString("0.0")
                            </div>
                            <div>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill text-warning" : "bi-star text-muted")"
                                       style="font-size:.9rem;"></i>
                                }
                            </div>
                            <div class="text-muted mt-1" style="font-size:.8rem;">Course Rating</div>
                        </div>
                        <div class="flex-grow-1">
                            @for (int star = 5; star >= 1; star--)
                            {
                                var count = Model.Reviews.Count(r => r.Rate == star);
                                var pct   = Model.Reviews.Any() ? (int)((double)count / Model.Reviews.Count * 100) : 0;
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <div class="progress flex-grow-1" style="height:8px;">
                                        <div class="progress-bar" style="width:@pct%; background:var(--primary);"></div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1 flex-shrink-0" style="font-size:.78rem; width:40px;">
                                        <i class="bi bi-star-fill text-warning"></i> @star
                                    </div>
                                    <span class="text-muted flex-shrink-0" style="font-size:.78rem; width:30px;">@pct%</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-4">
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="card border-0 shadow-sm p-4" style="background:var(--card-bg); border-radius:14px;">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="avatar flex-shrink-0" style="width:42px; height:42px; font-size:.95rem; border-radius:50%;">
                                        @review.StudentInitial
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-1">
                                            <span class="fw-semibold" style="color:var(--text);">@review.StudentName</span>
                                            <span class="text-muted" style="font-size:.8rem;">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                        <div class="mb-2">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.Rate ? "bi-star-fill text-warning" : "bi-star text-muted")"
                                                   style="font-size:.8rem;"></i>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(review.Comment))
                                        {
                                            <p class="mb-0" style="color:var(--text); font-size:.93rem; line-height:1.7;">@review.Comment</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-chat-square-text" style="font-size:2.5rem; opacity:.4;"></i>
                        <p class="mt-2 mb-0">No reviews yet. Be the first to review this course.</p>
                    </div>
                }

                @* ── Write a Review (enrolled students who haven't reviewed yet) ── *@
                @if (isStudent && Model.IsEnrolled && !Model.HasReviewed)
                {
                    <div class="mt-5 p-4 rounded-4" style="background:var(--card-bg); border:1px solid var(--border);">
                        <h5 class="fw-bold mb-1" style="color:var(--text);">
                            <i class="bi bi-pencil-square me-2" style="color:var(--primary);"></i>Write a Review
                        </h5>
                        <p class="text-muted mb-4" style="font-size:.88rem;">Share your experience with other learners.</p>

                        <form asp-controller="Review" asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CourseId" value="@Model.Id" />

                            <div class="mb-4">
                                <label class="form-label fw-semibold" style="color:var(--text);">Rating</label>
                                <div class="d-flex gap-2" id="starRatingRow">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        <button type="button" class="star-btn border-0 bg-transparent p-0"
                                                data-value="@s" style="font-size:1.8rem; color:#d1d5db; cursor:pointer; transition:color .15s;">
                                            ★
                                        </button>
                                    }
                                </div>
                                <input type="hidden" name="Rating" id="ratingInput" value="0" />
                                <div id="ratingError" class="text-danger mt-1" style="font-size:.83rem; display:none;">Please select a rating.</div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold" style="color:var(--text);">Comment</label>
                                <textarea name="Comment" class="form-control" rows="4"
                                          placeholder="What did you think of this course? What worked well? What could be improved?"
                                          required minlength="5"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary px-4" id="submitReviewBtn">
                                <i class="bi bi-send me-1"></i> Submit Review
                            </button>
                        </form>
                    </div>
                }
                else if (isStudent && Model.IsEnrolled && Model.HasReviewed)
                {
                    <div class="mt-4 alert alert-success" style="border-radius:12px;">
                        <i class="bi bi-check-circle-fill me-2"></i> You've already reviewed this course. Thank you!
                    </div>
                }
                else if (isStudent && !Model.IsEnrolled)
                {
                    <div class="mt-4 p-3 rounded-3 text-center text-muted" style="background:var(--bg); border:1px dashed var(--border); font-size:.9rem;">
                        <i class="bi bi-lock me-1"></i> Enroll in this course to leave a review.
                    </div>
                }
            </section>

        </div>

        @* ── Sidebar on desktop (Related Courses) ── *@
        <div class="col-lg-4 d-none d-lg-block">
            @if (Model.RelatedCourses.Any())
            {
                <div class="position-sticky" style="top:100px;">
                    <h5 class="fw-bold mb-4" style="color:var(--text);">Related Courses</h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var related in Model.RelatedCourses)
                        {
                            <a asp-controller="Course" asp-action="Details" asp-route-id="@related.Id"
                               class="card border-0 shadow-sm text-decoration-none" style="background:var(--card-bg); border-radius:12px; overflow:hidden;">
                                <div class="d-flex gap-3 p-3 align-items-center">
                                    <img src="@(string.IsNullOrEmpty(related.ImageUrl) ? "/images/Courses/default.avif" : "/images/Courses/" + related.ImageUrl)"
                                         style="width:64px; height:46px; object-fit:cover; border-radius:8px; flex-shrink:0;"
                                         onerror="this.src='/images/Courses/default.avif'" />
                                    <div class="overflow-hidden">
                                        <div class="fw-semibold text-truncate" style="color:var(--text); font-size:.88rem;">@related.Title</div>
                                        <div class="text-muted" style="font-size:.78rem;">@related.InstructorName</div>
                                        <div style="font-size:.78rem;">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <span style="color:var(--text);">@related.AverageRating.ToString("0.0")</span>
                                            <span class="ms-2 fw-semibold" style="color:var(--primary);">
                                                @(related.Price == 0 ? "Free" : related.Price.ToString("C", new System.Globalization.CultureInfo("en-US")))
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ═══════════════════════════════════════════════════════════
       6. RELATED COURSES (mobile — shown below on small screens)
    ═══════════════════════════════════════════════════════════ *@
    @if (Model.RelatedCourses.Any())
    {
        <div class="d-lg-none mt-4">
            <h5 class="fw-bold mb-3" style="color:var(--text);">Related Courses</h5>
            <div class="row g-3">
                @foreach (var related in Model.RelatedCourses)
                {
                    <div class="col-6">
                        @await Html.PartialAsync("_CourseCardVM", related)
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const stars  = document.querySelectorAll('.star-btn');
            const input  = document.getElementById('ratingInput');
            const errDiv = document.getElementById('ratingError');
            if (!stars.length) return;

            function paint(val) {
                stars.forEach(s => {
                    s.style.color = parseInt(s.dataset.value) <= val ? '#f59e0b' : '#d1d5db';
                });
            }

            stars.forEach(s => {
                s.addEventListener('mouseenter', () => paint(parseInt(s.dataset.value)));
                s.addEventListener('mouseleave', () => paint(parseInt(input.value) || 0));
                s.addEventListener('click', () => {
                    input.value = s.dataset.value;
                    paint(parseInt(s.dataset.value));
                    errDiv.style.display = 'none';
                });
            });

            document.getElementById('submitReviewBtn')?.addEventListener('click', function (e) {
                if (!input.value || input.value === '0') {
                    e.preventDefault();
                    errDiv.style.display = 'block';
                }
            });
        })();
    </script>
}
