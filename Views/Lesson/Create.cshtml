@using CourseManagementSystem.ViewModels
@model LessonViewModel

@{
    ViewData["Title"] = "Add New Lesson";
}

<style>
    :root {
        --learnly-purple: #7c4dff;
        --learnly-purple-hover: #6536ec;
        --learnly-bg-light: #f8f9fa;
        --learnly-text-dark: #1d1b4b;
        --learnly-border: #e2e8f0;
    }

    body {
        background-color: var(--learnly-bg-light);
    }

    .learnly-card {
        border: 1px solid var(--learnly-border);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .form-control:focus {
        border-color: var(--learnly-purple);
        box-shadow: 0 0 0 3px rgba(124, 77, 255, 0.15);
    }

    .btn-learnly-primary {
        background-color: var(--learnly-purple);
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 0.65rem 1.75rem;
        transition: background-color 0.2s ease;
    }

        .btn-learnly-primary:hover {
            background-color: var(--learnly-purple-hover);
            color: #ffffff;
        }

    .btn-learnly-secondary {
        background-color: transparent;
        color: #64748b;
        font-weight: 600;
        border: 1px solid var(--learnly-border);
        border-radius: 8px;
        padding: 0.65rem 1.75rem;
        transition: all 0.2s ease;
    }

        .btn-learnly-secondary:hover {
            background-color: #f1f5f9;
            color: #334155;
        }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="mb-4">
                <a asp-action="Index" asp-route-sectionId="@Model.SectionId" class="text-decoration-none text-muted small">
                    <i class="fas fa-arrow-left me-1"></i> Back to Lessons
                </a>
            </div>

            <div class="card learnly-card p-4 p-sm-5">

                <div class="mb-4">
                    <h3 class="fw-bold mb-1" style="color: var(--learnly-text-dark);">Add New Lesson</h3>
                    <p class="text-muted small">Create a new lesson and attach it to this section.</p>
                </div>

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <input type="hidden" asp-for="SectionId" />

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label fw-semibold text-secondary small">Lesson Title</label>
                        <input asp-for="Title" class="form-control form-control-lg fs-6" placeholder="e.g. 01 - Components & Props" autofocus />
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Index" asp-route-sectionId="@Model.SectionId" class="btn btn-learnly-secondary">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-learnly-primary px-4">
                            Save Lesson
                        </button>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}