@model IEnumerable<CourseManagementSystem.Models.Lesson>

@{
    ViewData["Title"] = "Lessons Management";
    int sectionId = ViewBag.SectionId;
}

<style>
    :root {
        --learnly-purple: #7c4dff;
        --learnly-purple-hover: #6536ec;
        --learnly-bg-light: #f8f9fa;
        --learnly-text-dark: #1d1b4b;
        --learnly-border: #e2e8f0;
    }

    body {
        background-color: var(--learnly-bg-light);
    }

    .learnly-card {
        border: 1px solid var(--learnly-border);
        border-radius: 16px;
        background: #ffffff;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }

    .lesson-item {
        border-bottom: 1px solid var(--learnly-border);
        transition: background-color 0.2s ease;
    }

        .lesson-item:last-child {
            border-bottom: none;
        }

        .lesson-item:hover {
            background-color: #f8fafc;
        }

    .btn-learnly-primary {
        background-color: var(--learnly-purple);
        color: #ffffff;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 1.25rem;
        transition: background-color 0.2s ease;
    }

        .btn-learnly-primary:hover {
            background-color: var(--learnly-purple-hover);
            color: #ffffff;
        }

    .btn-action {
        border-radius: 6px;
        padding: 0.4rem 0.8rem;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s ease;
    }
</style>

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--learnly-text-dark);">📚 Section Lessons</h2>
            <p class="text-muted small mb-0">Manage and organize lessons for this section</p>
        </div>

        <a asp-controller="Lesson"
           asp-action="Create"
           asp-route-sectionId="@sectionId"
           class="btn btn-learnly-primary shadow-sm">
            <i class="fas fa-plus me-2"></i> Add New Lesson
        </a>
    </div>

    <div class="card learnly-card p-2">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <span class="fs-1 d-block mb-3">📭</span>
                <h5 class="fw-bold text-muted">No lessons found in this section</h5>
                <p class="text-muted small">Click the "Add New Lesson" button above to get started.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-borderless align-middle mb-0">
                    <thead>
                        <tr class="border-bottom" style="--bs-border-color: var(--learnly-border);">
                            <th class="ps-4 py-3 text-muted" style="font-size: 0.85rem; font-weight: 600;">LESSON TITLE</th>
                            <th class="pe-4 py-3 text-end" style="font-size: 0.85rem; font-weight: 600;">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lesson in Model)
                        {
                            <tr class="lesson-item">
                                <td class="ps-4 py-3">
                                    <span class="fw-semibold text-dark">@lesson.Title</span>
                                </td>

                                <td class="pe-4 py-3 text-end">

                                    <a asp-controller="Lesson"
                                       asp-action="Edit"
                                       asp-route-id="@lesson.Id"
                                       class="btn btn-outline-warning btn-action me-2">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>

                                    <a asp-controller="Lesson"
                                       asp-action="Delete"
                                       asp-route-id="@lesson.Id"
                                       class="btn btn-outline-danger btn-action">
                                        <i class="fas fa-trash-alt"></i> Delete
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>