@model List<CourseManagementSystem.Models.CartItem>

@{
    ViewData["Title"] = "My Cart";
    var total = Model.Sum(i => i.Course?.Price ?? 0);
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="fw-bold mb-1" style="color:var(--text);">
                <i class="bi bi-cart3 me-2" style="color:var(--primary);"></i>My Cart
            </h2>
            <p class="text-muted mb-4">@Model.Count course(s) in cart</p>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x" style="font-size:4rem;color:var(--primary);opacity:.4;"></i>
                    <h4 class="mt-3" style="color:var(--text);">Your cart is empty</h4>
                    <p class="text-muted">Browse our courses and add something you like.</p>
                    <a asp-controller="Course" asp-action="Index" class="btn-primary-learnly mt-2">Browse Courses</a>
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="card mb-3 border-0 shadow-sm" style="background:var(--card-bg);">
                        <div class="card-body d-flex gap-3 align-items-center">
                            <img src="@(string.IsNullOrEmpty(item.Course?.ImageUrl) ? "/images/Courses/default.avif" : $"/images/Courses/{item.Course.ImageUrl}")"
                                 onerror="this.src='/images/Courses/default.avif'"
                                 alt="@item.Course?.Title"
                                 style="width:100px;height:68px;object-fit:cover;border-radius:8px;" />

                            <div class="flex-grow-1">
                                <h6 class="mb-1 fw-semibold" style="color:var(--text);">@item.Course?.Title</h6>
                                <small class="text-muted">By @(item.Course?.Instructor?.FullName ?? "Expert Instructor")</small>
                            </div>

                            <div class="text-end">
                                <div class="fw-bold mb-2" style="color:var(--primary);font-size:1.1rem;">
                                    @(item.Course?.Price == 0 ? "Free" : item.Course?.Price.ToString("C"))
                                </div>
                                <a asp-controller="Cart" asp-action="Remove" asp-route-courseId="@item.CourseId"
                                   class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash me-1"></i>Remove
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @if (Model.Any())
        {
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top:90px;background:var(--card-bg);">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3" style="color:var(--text);">Order Summary</h5>

                        <div class="d-flex justify-content-between mb-2 text-muted">
                            <span>Subtotal (@Model.Count item(s))</span>
                            <span>@total.ToString("C")</span>
                        </div>

                        <hr style="border-color:var(--border);" />

                        <div class="d-flex justify-content-between fw-bold mb-4" style="color:var(--text);font-size:1.1rem;">
                            <span>Total</span>
                            <span style="color:var(--primary);">@total.ToString("C")</span>
                        </div>

                        <form asp-controller="Cart" asp-action="Checkout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn-primary-learnly w-100 py-2">
                                <i class="bi bi-bag-check me-2"></i>Checkout & Enroll
                            </button>
                        </form>

                        <a asp-controller="Course" asp-action="Index"
                           class="btn-outline-learnly w-100 text-center mt-2 d-block py-2">
                            Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>