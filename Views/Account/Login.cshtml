@model CourseManagementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

@section Styles {
    <style>
        .auth-wrapper {
            min-height: calc(100vh - 140px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2.5rem;
            width: 100%;
            max-width: 460px;
            box-shadow: var(--shadow-elegant);
        }

        .auth-logo {
            display: grid;
            place-items: center;
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: var(--gradient-primary);
            color: #fff;
            font-size: 1.5rem;
            margin: 0 auto 1rem;
        }

        .auth-title {
            font-size: 1.5rem;
            font-weight: 800;
            text-align: center;
            color: var(--text);
            margin-bottom: .25rem;
        }

        .auth-subtitle {
            text-align: center;
            color: var(--text-muted);
            font-size: .9rem;
            margin-bottom: 2rem;
        }

        .form-label-learnly {
            font-size: .85rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: .4rem;
        }

        .form-control-learnly {
            background: var(--bg-soft);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            padding: .65rem 1rem;
            font-size: .92rem;
            transition: all .15s;
            width: 100%;
        }

        .form-control-learnly:focus {
            outline: none;
            background: var(--card-bg);
            border-color: var(--primary-glow);
            box-shadow: 0 0 0 3px rgba(167,139,250,.2);
            color: var(--text);
        }

        .input-icon-wrap {
            position: relative;
        }

        .input-icon-wrap .bi {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        .input-icon-wrap .form-control-learnly {
            padding-left: 2.4rem;
        }

        .btn-auth {
            width: 100%;
            padding: .75rem;
            border-radius: 12px;
            font-weight: 700;
            font-size: .95rem;
            border: none;
            background: var(--gradient-primary);
            color: #fff;
            box-shadow: var(--shadow-elegant);
            transition: all .15s;
        }

        .btn-auth:hover { opacity: .9; transform: translateY(-1px); }

        .auth-footer-text {
            text-align: center;
            font-size: .88rem;
            color: var(--text-muted);
            margin-top: 1.25rem;
        }

        .auth-footer-text a { color: var(--primary); font-weight: 600; }

        .field-error {
            font-size: .8rem;
            color: #ef4444;
            margin-top: .3rem;
            display: block;
        }

        .alert-auth {
            background: rgba(239,68,68,.1);
            border: 1px solid rgba(239,68,68,.25);
            color: #ef4444;
            border-radius: 10px;
            padding: .75rem 1rem;
            font-size: .88rem;
            margin-bottom: 1.25rem;
        }

        .demo-accounts {
            background: var(--bg-soft);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1rem;
            margin-top: 1.5rem;
        }

        .demo-title {
            font-size: .8rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-bottom: .6rem;
        }

        .demo-item {
            display: flex;
            justify-content: space-between;
            font-size: .82rem;
            padding: .25rem 0;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border);
        }

        .demo-item:last-child { border-bottom: none; }
        .demo-item strong { color: var(--text); }
    </style>
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo"><i class="bi bi-mortarboard-fill"></i></div>
        <div class="auth-title">Welcome back!</div>
        <div class="auth-subtitle">Sign in to continue learning</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-auth">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Login"
              asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label-learnly">Email Address</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control-learnly" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label-learnly">Password</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" class="form-control-learnly" placeholder="Your password" />
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="mb-4">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label" style="font-size:.88rem;color:var(--text-muted);"
                           for="rememberMe">Remember me</label>
                </div>
            </div>

            <button type="submit" class="btn-auth">
                <i class="bi bi-box-arrow-in-right me-1"></i> Log In
            </button>
        </form>

        <div class="auth-footer-text">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Sign up for free</a>
        </div>

        <div class="demo-accounts">
            <div class="demo-title">Demo Accounts</div>
            <div class="demo-item">
                <span><i class="bi bi-shield-lock me-1"></i> <strong>Admin</strong></span>