@model CourseManagementSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
}

@section Styles {
    <style>
        .auth-wrapper {
            min-height: calc(100vh - 140px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 2.5rem;
            width: 100%;
            max-width: 520px;
            box-shadow: var(--shadow-elegant);
        }

        .auth-logo {
            display: grid;
            place-items: center;
            width: 56px;
            height: 56px;
            border-radius: 14px;
            background: var(--gradient-primary);
            color: #fff;
            font-size: 1.5rem;
            margin: 0 auto 1rem;
        }

        .auth-title {
            font-size: 1.5rem;
            font-weight: 800;
            text-align: center;
            color: var(--text);
            margin-bottom: .25rem;
        }

        .auth-subtitle {
            text-align: center;
            color: var(--text-muted);
            font-size: .9rem;
            margin-bottom: 2rem;
        }

        .form-label-learnly {
            font-size: .85rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: .4rem;
        }

        .form-control-learnly {
            background: var(--bg-soft);
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text);
            padding: .65rem 1rem;
            font-size: .92rem;
            transition: all .15s;
            width: 100%;
        }

        .form-control-learnly:focus {
            outline: none;
            background: var(--card-bg);
            border-color: var(--primary-glow);
            box-shadow: 0 0 0 3px rgba(167,139,250,.2);
            color: var(--text);
        }

        .input-icon-wrap {
            position: relative;
        }

        .input-icon-wrap .bi {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            pointer-events: none;
        }

        .input-icon-wrap .form-control-learnly {
            padding-left: 2.4rem;
        }

        .role-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .75rem;
        }

        .role-card input[type="radio"] { display: none; }

        .role-label {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: .5rem;
            padding: 1rem;
            border: 2px solid var(--border);
            border-radius: 12px;
            cursor: pointer;
            color: var(--text-muted);
            font-size: .88rem;
            font-weight: 600;
            transition: all .15s;
            background: var(--bg-soft);
        }

        .role-label .bi { font-size: 1.6rem; }

        .role-card input[type="radio"]:checked + .role-label {
            border-color: var(--primary);
            color: var(--primary);
            background: color-mix(in srgb, var(--primary) 8%, transparent);
        }

        .btn-auth {
            width: 100%;
            padding: .75rem;
            border-radius: 12px;
            font-weight: 700;
            font-size: .95rem;
            border: none;
            background: var(--gradient-primary);
            color: #fff;
            box-shadow: var(--shadow-elegant);
            transition: all .15s;
        }

        .btn-auth:hover { opacity: .9; transform: translateY(-1px); }

        .auth-footer-text {
            text-align: center;
            font-size: .88rem;
            color: var(--text-muted);
            margin-top: 1.25rem;
        }

        .auth-footer-text a { color: var(--primary); font-weight: 600; }

        .field-error {
            font-size: .8rem;
            color: #ef4444;
            margin-top: .3rem;
            display: block;
        }

        .alert-auth {
            background: rgba(239,68,68,.1);
            border: 1px solid rgba(239,68,68,.25);
            color: #ef4444;
            border-radius: 10px;
            padding: .75rem 1rem;
            font-size: .88rem;
            margin-bottom: 1.25rem;
        }
    </style>
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo"><i class="bi bi-mortarboard-fill"></i></div>
        <div class="auth-title">Create your account</div>
        <div class="auth-subtitle">Join thousands of learners and instructors on Learnly</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-auth">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="FullName" class="form-label-learnly">Full Name</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-person"></i>
                    <input asp-for="FullName" class="form-control-learnly" placeholder="John Doe" />
                </div>
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label-learnly">Email Address</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control-learnly" placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Bio" class="form-label-learnly">
                    Bio <span style="font-weight:400;color:var(--text-muted)">(optional)</span>
                </label>
                <textarea asp-for="Bio" class="form-control-learnly" rows="2"
                          placeholder="Tell us a little about yourself..."></textarea>
                <span asp-validation-for="Bio" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label class="form-label-learnly">I want to join as a</label>
                <div class="role-selector">
                    <div class="role-card">
                        <input type="radio" name="SelectedRole" id="roleStudent" value="Student" checked />
                        <label class="role-label" for="roleStudent">
                            <i class="bi bi-mortarboard"></i> Student
                        </label>
                    </div>
                    <div class="role-card">
                        <input type="radio" name="SelectedRole" id="roleInstructor" value="Instructor" />
                        <label class="role-label" for="roleInstructor">
                            <i class="bi bi-easel2"></i> Instructor
                        </label>
                    </div>
                </div>
                <span asp-validation-for="SelectedRole" class="field-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label-learnly">Password</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-lock"></i>
                    <input asp-for="Password" class="form-control-learnly" placeholder="Min. 6 characters" />
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label-learnly">Confirm Password</label>
                <div class="input-icon-wrap">
                    <i class="bi bi-lock-fill"></i>
                    <input asp-for="ConfirmPassword" class="form-control-learnly" placeholder="Repeat your password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn-auth">
                <i class="bi bi-person-plus me-1"></i> Create Account
            </button>
        </form>

        <div class="auth-footer-text">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Log in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}