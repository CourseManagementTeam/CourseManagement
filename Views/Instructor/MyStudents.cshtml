@model List<CourseManagementSystem.ViewModels.InstructorStudentVM>

@{
    ViewData["Title"] = "My Students";
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold" style="color:var(--text);">
            <i class="bi bi-people me-2" style="color:var(--primary);"></i>My Students
        </h2>
        <p class="text-muted">All students enrolled across your courses.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-mortarboard" style="font-size:3rem;"></i>
            <p class="mt-3">No students enrolled in your courses yet.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm" style="background:var(--card-bg); border-radius:16px; overflow:hidden;">
            <div class="table-responsive">
                <table class="table table-hover mb-0" style="color:var(--text);">
                    <thead style="background:var(--bg);">
                        <tr>
                            <th class="px-4 py-3">Student</th>
                            <th class="py-3">Course</th>
                            <th class="py-3">Enrolled</th>
                            <th class="py-3">Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="px-4 py-3">
                                    <div class="fw-semibold">@s.FullName</div>
                                    <div style="font-size:.8rem; color:#6b7280;">@s.Email</div>
                                </td>
                                <td class="py-3">@s.CourseName</td>
                                <td class="py-3" style="font-size:.85rem;">@s.EnrolledAt.ToString("MMM dd, yyyy")</td>
                                <td class="py-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height:6px; max-width:100px;">
                                            <div class="progress-bar bg-success" style="width:@s.ProgressPercentage%;"></div>
                                        </div>
                                        <span style="font-size:.8rem; color:#6b7280;">@s.ProgressPercentage%</span>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>