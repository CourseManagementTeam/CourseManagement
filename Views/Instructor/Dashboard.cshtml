@model CourseManagementSystem.ViewModels.InstructorDashboardVM

@{
    ViewData["Title"] = "Instructor Dashboard";
}

<div class="container py-5">

    <div class="mb-4">
        <h2 class="fw-bold" style="color:var(--text);">
            <i class="bi bi-speedometer2 me-2" style="color:var(--primary);"></i>Instructor Dashboard
        </h2>
        <p class="text-muted">Overview of your courses and students.</p>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 h-100" style="background:var(--card-bg);">
                <div style="font-size:2.2rem; color:var(--primary);" class="mb-2">@Model.TotalCourses</div>
                <div style="color:var(--text); font-size:.9rem;">Total Courses</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 h-100" style="background:var(--card-bg);">
                <div style="font-size:2.2rem; color:#10b981;" class="mb-2">@Model.TotalStudents</div>
                <div style="color:var(--text); font-size:.9rem;">Total Students</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 h-100" style="background:var(--card-bg);">
                <div style="font-size:2.2rem; color:#f59e0b;" class="mb-2">@Model.AverageRating.ToString("0.0")</div>
                <div style="color:var(--text); font-size:.9rem;">Average Rating</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center p-4 h-100" style="background:var(--card-bg);">
                <div style="font-size:2.2rem; color:#8b5cf6;" class="mb-2">@Model.TotalReviews</div>
                <div style="color:var(--text); font-size:.9rem;">Total Reviews</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0" style="color:var(--text);">My Courses</h4>
        <a asp-controller="Course" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>New Course
        </a>
    </div>

    @if (!Model.Courses.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-journal-x" style="font-size:3rem;"></i>
            <p class="mt-3">You haven't created any courses yet.</p>
            <a asp-controller="Course" asp-action="Create" class="btn btn-primary">Create Your First Course</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model.Courses)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100" style="background:var(--card-bg); border-radius:16px; overflow:hidden;">
                        <img src="@(string.IsNullOrEmpty(course.ImageUrl) ? "/images/Courses/default.avif" : "/images/Courses/" + course.ImageUrl)"
                             style="height:160px; object-fit:cover; width:100%;"
                             onerror="this.src='/images/Courses/default.avif'" />
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-1" style="color:var(--text);">@course.Title</h6>
                            <div class="d-flex align-items-center gap-3 mb-2" style="font-size:.82rem; color:#6b7280;">
                                <span><i class="bi bi-people me-1"></i>@(course.Enrollments?.Count ?? 0) students</span>
                                <span><i class="bi bi-star-fill text-warning me-1"></i>@course.AverageRating.ToString("0.0")</span>
                            </div>
                            <div class="mb-2">
                                @if (course.IsPublished)
                                {
                                    <span class="badge bg-success">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Draft</span>
                                }
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <a asp-controller="Course" asp-action="Edit" asp-route-id="@course.Id"
                                   class="btn btn-sm btn-outline-primary flex-fill">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-controller="Course" asp-action="Details" asp-route-id="@course.Id"
                                   class="btn btn-sm btn-outline-secondary flex-fill">
                                    <i class="bi bi-eye me-1"></i>View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>