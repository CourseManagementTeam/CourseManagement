@{
    var currentUser = User?.Identity?.IsAuthenticated ?? false;
    var userName = currentUser ? User.Identity.Name : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Learnly</title>
    <meta name="description" content="Learnly - Learn anything, build your future." />

    <script>
            (function () {
                var t = localStorage.getItem('learnly-theme') ||
                        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', t);
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root,
            [data-theme="light"] {
                --primary: #6d28d9;
                --primary-dark: #5b21b6;
                --primary-glow: #a78bfa;
                --secondary: #f59e0b;
                --bg: #ffffff;
                --bg-soft: #f8fafc;
                --card-bg: #ffffff;
                --text: #1e1b4b;
                --text-muted: #64748b;
                --border: #e2e8f0;
                --header-bg: rgba(255,255,255,.92);
                --gradient-hero: linear-gradient(135deg, #4c1d95 0%, #6d28d9 50%, #a78bfa 100%);
                --gradient-primary: linear-gradient(135deg, #6d28d9, #a78bfa);
                --shadow-elegant: 0 10px 30px -10px rgba(109, 40, 217, 0.35);
                --shadow-card: 0 4px 16px -6px rgba(109, 40, 217, 0.18);
            }

            [data-theme="dark"] {
                --primary: #a78bfa;
                --primary-dark: #8b5cf6;
                --primary-glow: #c4b5fd;
                --secondary: #fbbf24;
                --bg: #0f0c1f;
                --bg-soft: #1a1633;
                --card-bg: #1a1633;
                --text: #f1f5f9;
                --text-muted: #94a3b8;
                --border: #2a2348;
                --header-bg: rgba(15,12,31,.85);
                --gradient-hero: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 50%, #6d28d9 100%);
                --gradient-primary: linear-gradient(135deg, #8b5cf6, #c4b5fd);
                --shadow-elegant: 0 10px 30px -10px rgba(0,0,0,.6);
                --shadow-card: 0 4px 16px -6px rgba(0,0,0,.5);
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', system-ui, sans-serif;
                background: var(--bg);
                color: var(--text);
                margin: 0;
                -webkit-font-smoothing: antialiased;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                transition: background .25s ease, color .25s ease;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .site-header {
                position: sticky;
                top: 0;
                z-index: 1030;
                background: var(--header-bg);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border);
            }

            .navbar-brand-learnly {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 800;
                font-size: 1.25rem;
                color: var(--text);
            }

            .brand-logo {
                display: grid;
                place-items: center;
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--gradient-primary);
                color: #fff;
                box-shadow: var(--shadow-elegant);
            }

            .nav-link-learnly {
                padding: .5rem .85rem;
                border-radius: 8px;
                font-size: .92rem;
                font-weight: 500;
                color: var(--text-muted);
                transition: all .15s;
            }

                .nav-link-learnly:hover, .nav-link-learnly.active {
                    color: var(--primary);
                    background: var(--bg-soft);
                }

            .search-box {
                position: relative;
                max-width: 420px;
                width: 100%;
            }

                .search-box .bi {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                }

                .search-box input {
                    width: 100%;
                    padding: .55rem .9rem .55rem 2.3rem;
                    border-radius: 10px;
                    border: 1px solid transparent;
                    background: var(--bg-soft);
                    color: var(--text);
                    font-size: .9rem;
                }

                    .search-box input:focus {
                        outline: none;
                        background: var(--card-bg);
                        border-color: var(--primary-glow);
                        box-shadow: 0 0 0 3px rgba(167,139,250,.25);
                    }

            .icon-btn {
                display: inline-grid;
                place-items: center;
                width: 40px;
                height: 40px;
                border-radius: 10px;
                color: var(--text-muted);
                background: transparent;
                border: none;
                transition: all .15s;
            }

                .icon-btn:hover {
                    background: var(--bg-soft);
                    color: var(--primary);
                }

            .btn-primary-learnly {
                background: var(--gradient-primary);
                color: #fff;
                border: none;
                padding: .5rem 1.1rem;
                border-radius: 10px;
                font-weight: 600;
                font-size: .9rem;
                box-shadow: var(--shadow-elegant);
            }

                .btn-primary-learnly:hover {
                    opacity: .92;
                    color: #fff;
                    transform: translateY(-1px);
                }

            .btn-outline-learnly {
                border: 1px solid var(--border);
                color: var(--text);
                background: var(--card-bg);
                padding: .5rem 1.1rem;
                border-radius: 10px;
                font-weight: 600;
                font-size: .9rem;
            }

                .btn-outline-learnly:hover {
                    border-color: var(--primary);
                    color: var(--primary);
                }

            .avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--gradient-primary);
                color: #fff;
                display: grid;
                place-items: center;
                font-weight: 700;
                font-size: .9rem;
            }

            .dropdown-menu {
                background: var(--card-bg);
                border: 1px solid var(--border);
                color: var(--text);
            }

            .dropdown-item {
                color: var(--text);
            }

                .dropdown-item:hover {
                    background: var(--bg-soft);
                    color: var(--primary);
                }

            /* --- تحسينات ألوان التوافق والـ Dark Mode الموحدة --- */
            [data-theme="dark"] .text-muted {
                color: var(--text-muted) !important;
            }

            [data-theme="dark"] .bg-body-tertiary {
                background-color: var(--bg-soft) !important;
            }

            .btn-primary {
                background: var(--gradient-primary) !important;
                border: none !important;
                color: #fff !important;
            }

                .btn-primary:hover {
                    opacity: 0.9;
                }

            .btn-outline-primary {
                border-color: var(--primary) !important;
                color: var(--primary) !important;
                background: transparent !important;
            }

                .btn-outline-primary:hover {
                    background: var(--primary) !important;
                    color: #fff !important;
                }
            /* -------------------------------------------------- */

            .site-footer {
                background: var(--bg-soft);
                border-top: 1px solid var(--border);
                padding: 3rem 0 1.5rem;
                margin-top: auto;
            }

            .footer-title {
                font-size: .9rem;
                font-weight: 700;
                margin-bottom: 1rem;
                color: var(--text);
            }

            .footer-link {
                display: block;
                font-size: .88rem;
                color: var(--text-muted);
                padding: .3rem 0;
            }

                .footer-link:hover {
                    color: var(--primary);
                }

            .social-icon {
                display: inline-grid;
                place-items: center;
                width: 36px;
                height: 36px;
                border-radius: 8px;
                color: var(--text-muted);
                background: var(--card-bg);
                border: 1px solid var(--border);
                margin-right: 8px;
            }

                .social-icon:hover {
                    color: var(--primary);
                    border-color: var(--primary);
                }

            main {
                flex: 1;
            }

            .alert-floating {
                position: fixed;
                top: 80px;
                right: 20px;
                z-index: 1050;
                min-width: 280px;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg py-2">
                <a class="navbar-brand-learnly" href="/">
                    <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
                    Learnly
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-3 me-auto">
                        <li class="nav-item">
                            <a class="nav-link-learnly" href="/">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-learnly" href="/Course">Courses</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link-learnly" href="/Category">Categories</a>
                        </li>

                        @if (currentUser)
                        {
                            <li class="nav-item">
                                <a class="nav-link-learnly"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link-learnly"
                                   asp-controller="Enrollment"
                                   asp-action="MyCourses">
                                    My Courses
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link-learnly"
                                   asp-controller="Wishlist"
                                   asp-action="MyWishlist">
                                    Wishlist
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link-learnly"
                                   asp-controller="Review"
                                   asp-action="MyReviews">
                                    Reviews
                                </a>
                            </li>
                        }
                    </ul>

                    <form class="search-box me-3" action="/Course" method="get">
                        <i class="bi bi-search"></i>
                        <input type="search" name="q" placeholder="Search courses..." />
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        <button id="themeToggle" class="icon-btn" type="button" title="Toggle theme">
                            <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                        </button>

                        @if (currentUser)
                        {
                            <a class="icon-btn" href="/Wishlist" title="Wishlist"><i class="bi bi-heart"></i></a>
                            <a class="icon-btn" href="/Cart" title="Cart"><i class="bi bi-cart"></i></a>

                            <div class="dropdown">
                                <button class="avatar border-0" data-bs-toggle="dropdown">
                                    @(userName?.Substring(0, 1).ToUpper())
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li class="px-3 py-2">
                                        <div class="fw-bold">@userName</div>
                                        <small class="text-muted">Student account</small>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <a class="dropdown-item" href="/Profile">
                                            <i class="bi bi-person me-2"></i>
                                            Profile
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Dashboard"
                                           asp-action="Index">
                                            <i class="bi bi-speedometer2 me-2"></i>
                                            Dashboard
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Enrollment"
                                           asp-action="MyCourses">
                                            <i class="bi bi-journal-bookmark me-2"></i>
                                            My Courses
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Wishlist"
                                           asp-action="MyWishlist">
                                            <i class="bi bi-heart me-2"></i>
                                            Wishlist
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Review"
                                           asp-action="MyReviews">
                                            <i class="bi bi-star me-2"></i>
                                            My Reviews
                                        </a>
                                    </li>

                                    @if (User.IsInRole("Instructor"))
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Instructor">
                                                <i class="bi bi-easel me-2"></i>
                                                Instructor Dashboard
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item" href="/Admin">
                                                <i class="bi bi-shield-lock me-2"></i>
                                                Admin Panel
                                            </a>
                                        </li>
                                    }

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <form asp-controller="Account"
                                              asp-action="Logout"
                                              method="post"
                                              class="px-3">
                                            <button type="submit"
                                                    class="btn btn-link p-0 text-danger">
                                                Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn-outline-learnly" href="/Account/Login">Log in</a>
                            <a class="btn-primary-learnly" href="/Account/Register">Sign up</a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible alert-floating shadow">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible alert-floating shadow">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main>@RenderBody()</main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="navbar-brand-learnly mb-3" href="/">
                        <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
                        Learnly
                    </a>
                    <p class="text-muted mt-2" style="font-size:.9rem;">
                        Learn new skills from industry experts. Anytime, anywhere.
                    </p>
                    <div class="mt-3">
                        <a class="social-icon" href="#"><i class="bi bi-twitter-x"></i></a>
                        <a class="social-icon" href="#"><i class="bi bi-facebook"></i></a>
                        <a class="social-icon" href="#"><i class="bi bi-instagram"></i></a>
                        <a class="social-icon" href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="footer-title">Learn</div>
                    <a class="footer-link" href="/Course">All Courses</a>
                    <a class="footer-link" href="/Category">Categories</a>
                    <a class="footer-link" href="/MyLearning">My Learning</a>
                    <a class="footer-link" href="/Wishlist">Wishlist</a>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="footer-title">Teach</div>
                    <a class="footer-link" href="/Instructor/Apply">Become an Instructor</a>
                    <a class="footer-link" href="/Instructor">Instructor Dashboard</a>
                    <a class="footer-link" href="/Guidelines">Guidelines</a>
                </div>
                <div class="col-lg-4">
                    <div class="footer-title">Company</div>
                    <a class="footer-link" href="/About">About</a>
                    <a class="footer-link" href="/Contact">Contact</a>
                    <a class="footer-link" href="/Privacy">Privacy</a>
                    <a class="footer-link" href="/Terms">Terms</a>
                </div>
            </div>
            <hr class="my-4" style="border-color:var(--border);" />
            <div class="d-flex justify-content-between flex-wrap text-muted" style="font-size:.85rem;">
                <span>© @DateTime.Now.Year Learnly. All rights reserved.</span>
                <span>Built for learners and instructors.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Theme toggle
        (function () {
        var btn = document.getElementById('themeToggle');
        var icon = document.getElementById('themeIcon');
        function syncIcon() {
        var t = document.documentElement.getAttribute('data-theme');
        icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        }
        syncIcon();
        btn?.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('learnly-theme', next);
        syncIcon();
        });
        })();

        setTimeout(() => {
        document.querySelectorAll('.alert-floating').forEach(a => {
        bootstrap.Alert.getOrCreateInstance(a).close();
        });
        }, 4500);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

