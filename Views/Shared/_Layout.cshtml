@inject Microsoft.AspNetCore.Identity.SignInManager<CourseManagementSystem.Models.ApplicationUser> SignInManager
@inject Microsoft.AspNetCore.Identity.UserManager<CourseManagementSystem.Models.ApplicationUser> UserManager

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    CourseManagementSystem.Models.ApplicationUser? currentAppUser = null;
    string displayName = "";
    string displayInitial = "U";

    if (isSignedIn)
    {
        currentAppUser = await UserManager.GetUserAsync(User);
        displayName = currentAppUser?.FullName ?? User.Identity?.Name ?? "";
        displayInitial = displayName.Length > 0
            ? displayName.Substring(0, 1).ToUpper()
            : "U";
    }

    var currentUser = User?.Identity?.IsAuthenticated ?? false;
    var userName = currentUser ? User.Identity?.Name : "";
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var activeCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isArabic = currentCulture == "ar";
    var nextCulture = isArabic ? "en" : "ar";
    var nextCultureLabel = isArabic ? "EN" : "AR";
    var roleDisplay = User.IsInRole("Admin")
        ? "Admin"
        : User.IsInRole("Instructor")
            ? "Instructor"
            : "Student";
}
<!DOCTYPE html>
<html lang="@currentCulture" dir="@(isArabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Learnly</title>
    <meta name="description" content="Learnly - Learn anything, build your future." />

    <script>
            (function () {
                var t = localStorage.getItem('learnly-theme') ||
                    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', t);
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    @if (isArabic)
    {
        <style>body, * { font-family: 'Cairo', 'Segoe UI', system-ui, sans-serif !important; }</style>
    }

    <style>
            :root,
            [data-theme="light"] {
                --primary: #6d28d9;
                --primary-dark: #5b21b6;
                --primary-glow: #a78bfa;
                --secondary: #f59e0b;
                --bg: #ffffff;
                --bg-soft: #f8fafc;
                --card-bg: #ffffff;
                --text: #1e1b4b;
                --text-muted: #64748b;
                --border: #e2e8f0;
                --header-bg: rgba(255,255,255,.92);
                --gradient-hero: linear-gradient(135deg, #4c1d95 0%, #6d28d9 50%, #a78bfa 100%);
                --gradient-primary: linear-gradient(135deg, #6d28d9, #a78bfa);
                --shadow-elegant: 0 10px 30px -10px rgba(109, 40, 217, 0.35);
                --shadow-card: 0 4px 16px -6px rgba(109, 40, 217, 0.18);
            }

            [data-theme="dark"] {
                --primary: #a78bfa;
                --primary-dark: #8b5cf6;
                --primary-glow: #c4b5fd;
                --secondary: #fbbf24;
                --bg: #0f0c1f;
                --bg-soft: #1a1633;
                --card-bg: #1a1633;
                --text: #f1f5f9;
                --text-muted: #94a3b8;
                --border: #2a2348;
                --header-bg: rgba(15,12,31,.85);
                --gradient-hero: linear-gradient(135deg, #1e1b4b 0%, #4c1d95 50%, #6d28d9 100%);
                --gradient-primary: linear-gradient(135deg, #8b5cf6, #c4b5fd);
                --shadow-elegant: 0 10px 30px -10px rgba(0,0,0,.6);
                --shadow-card: 0 4px 16px -6px rgba(0,0,0,.5);
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter', system-ui, sans-serif;
                background: var(--bg);
                color: var(--text);
                margin: 0;
                -webkit-font-smoothing: antialiased;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
                transition: background .25s ease, color .25s ease;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .site-header {
                position: sticky;
                top: 0;
                z-index: 1030;
                background: var(--header-bg);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border);
            }

            .navbar-brand-learnly {
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 800;
                font-size: 1.25rem;
                color: var(--text);
            }

            .brand-logo {
                display: grid;
                place-items: center;
                width: 38px;
                height: 38px;
                border-radius: 10px;
                background: var(--gradient-primary);
                color: #fff;
                box-shadow: var(--shadow-elegant);
            }

            .nav-link-learnly {
                padding: .5rem .85rem;
                border-radius: 8px;
                font-size: .92rem;
                font-weight: 500;
                color: var(--text-muted);
                transition: all .15s;
            }

                .nav-link-learnly:hover,
                .nav-link-learnly.active {
                    color: var(--primary);
                    background: var(--bg-soft);
                }

            .search-box {
                position: relative;
                max-width: 420px;
                width: 100%;
            }

                .search-box .bi {
                    position: absolute;
                    left: 14px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                }

                .search-box input {
                    width: 100%;
                    padding: .55rem .9rem .55rem 2.3rem;
                    border-radius: 10px;
                    border: 1px solid transparent;
                    background: var(--bg-soft);
                    color: var(--text);
                    font-size: .9rem;
                }

                    .search-box input:focus {
                        outline: none;
                        background: var(--card-bg);
                        border-color: var(--primary-glow);
                        box-shadow: 0 0 0 3px rgba(167,139,250,.25);
                    }

            .icon-btn {
                display: inline-grid;
                place-items: center;
                width: 40px;
                height: 40px;
                border-radius: 10px;
                color: var(--text-muted);
                background: transparent;
                border: none;
                transition: all .15s;
            }

                .icon-btn:hover {
                    background: var(--bg-soft);
                    color: var(--primary);
                }

            .btn-primary-learnly {
                background: var(--gradient-primary);
                color: #fff;
                border: none;
                padding: .5rem 1.1rem;
                border-radius: 10px;
                font-weight: 600;
                font-size: .9rem;
                box-shadow: var(--shadow-elegant);
            }

                .btn-primary-learnly:hover {
                    opacity: .92;
                    color: #fff;
                    transform: translateY(-1px);
                }

            .btn-outline-learnly {
                border: 1px solid var(--border);
                color: var(--text);
                background: var(--card-bg);
                padding: .5rem 1.1rem;
                border-radius: 10px;
                font-weight: 600;
                font-size: .9rem;
            }

                .btn-outline-learnly:hover {
                    border-color: var(--primary);
                    color: var(--primary);
                }

            .avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: var(--gradient-primary);
                color: #fff;
                display: grid;
                place-items: center;
                font-weight: 700;
                font-size: .9rem;
            }

            .avatar-img {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                object-fit: cover;
                border: 2px solid var(--border);
            }

            .dropdown-menu {
                background: var(--card-bg);
                border: 1px solid var(--border);
                color: var(--text);
            }

            .dropdown-item {
                color: var(--text);
            }

                .dropdown-item:hover {
                    background: var(--bg-soft);
                    color: var(--primary);
                }

            [data-theme="dark"] .text-muted {
                color: var(--text-muted) !important;
            }

            [data-theme="dark"] .bg-body-tertiary {
                background-color: var(--bg-soft) !important;
            }

            .btn-primary {
                background: var(--gradient-primary) !important;
                border: none !important;
                color: #fff !important;
            }

                .btn-primary:hover {
                    opacity: 0.9;
                }

            .btn-outline-primary {
                border-color: var(--primary) !important;
                color: var(--primary) !important;
                background: transparent !important;
            }

                .btn-outline-primary:hover {
                    background: var(--primary) !important;
                    color: #fff !important;
                }

            .site-footer {
                background: var(--bg-soft);
                border-top: 1px solid var(--border);
                padding: 3rem 0 1.5rem;
                margin-top: auto;
            }

            .footer-title {
                font-size: .9rem;
                font-weight: 700;
                margin-bottom: 1rem;
                color: var(--text);
            }

            .footer-link {
                display: block;
                font-size: .88rem;
                color: var(--text-muted);
                padding: .3rem 0;
            }

                .footer-link:hover {
                    color: var(--primary);
                }

            .social-icon {
                display: inline-grid;
                place-items: center;
                width: 36px;
                height: 36px;
                border-radius: 8px;
                color: var(--text-muted);
                background: var(--card-bg);
                border: 1px solid var(--border);
                margin-right: 8px;
            }

                .social-icon:hover {
                    color: var(--primary);
                    border-color: var(--primary);
                }

            main {
                flex: 1;
            }

            .alert-floating {
                position: fixed;
                top: 80px;
                right: 20px;
                z-index: 1050;
                min-width: 280px;
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container">
            <nav class="navbar navbar-expand-lg py-2">
                <a class="navbar-brand-learnly" href="/">
                    <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
                    Learnly
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3"></i>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-3 me-auto">
                        <li class="nav-item">
                            <a class="nav-link-learnly @(activeCtrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">@(isArabic ? "الرئيسية" : "Home")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-learnly @(activeCtrl == "Course" && activeAction == "Index" ? "active" : "")" asp-controller="Course" asp-action="Index">@(isArabic ? "الدورات" : "Courses")</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-learnly @(activeCtrl == "Category" ? "active" : "")" asp-controller="Category" asp-action="Index">@(isArabic ? "التصنيفات" : "Categories")</a>
                        </li>

                        @if (currentUser && User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">@(isArabic ? "لوحة التحكم" : "Dashboard")</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Enrollment" ? "active" : "")" asp-controller="Enrollment" asp-action="MyCourses">@(isArabic ? "دوراتي" : "My Courses")</a>
                            </li>
                        }

                        @if (currentUser && User.IsInRole("Instructor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Instructor" && activeAction == "dashboard" ? "active" : "")" asp-controller="Instructor" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2 me-1"></i>@(isArabic ? "لوحتي" : "Dashboard")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Course" && activeAction == "InstructorCourses" ? "active" : "")" asp-controller="Course" asp-action="InstructorCourses">
                                    <i class="bi bi-easel2 me-1"></i>@(isArabic ? "كورساتي" : "My Courses")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Instructor" && activeAction == "mystudents" ? "active" : "")" asp-controller="Instructor" asp-action="MyStudents">
                                    <i class="bi bi-people me-1"></i>@(isArabic ? "طلابي" : "My Students")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Course" && activeAction == "Create" ? "active" : "")" asp-controller="Course" asp-action="Create">
                                    @(isArabic ? "+ كورس جديد" : "+ New Course")
                                </a>
                            </li>
                        }

                        @if (currentUser && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Admin" ? "active" : "")" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>@(isArabic ? "لوحة الإدارة" : "Admin Panel")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link-learnly @(activeCtrl == "Category" ? "active" : "")" asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-grid me-1"></i>@(isArabic ? "إدارة التصنيفات" : "Manage Categories")
                                </a>
                            </li>
                        }
                    </ul>

                    <form class="search-box me-3"
                          asp-controller="Course"
                          asp-action="Index"
                          method="get">

                        <input type="search"
                               name="search"
                               placeholder="@(isArabic ? "ابحث عن دورات..." : "Search courses...")" />
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        <button id="themeToggle" class="icon-btn" type="button" title="Toggle theme">
                            <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                        </button>

                        <form asp-controller="Home" asp-action="SetCulture" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="culture" value="@nextCulture" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                            <button type="submit" class="icon-btn" title="Change language"
                                    style="font-size:.8rem;font-weight:700;">
                                @nextCultureLabel
                            </button>
                        </form>

                        @if (currentUser)
                        {
                            @if (User.IsInRole("Student"))
                            {
                                <a class="icon-btn" asp-controller="Cart" asp-action="Index" title="Cart">
                                    <i class="bi bi-cart3"></i>
                                </a>
                                <a class="icon-btn" asp-controller="Wishlist" asp-action="MyWishlist" title="Wishlist">
                                    <i class="bi bi-heart"></i>
                                </a>
                            }

                            <div class="dropdown">
                                @if (currentAppUser != null && !string.IsNullOrWhiteSpace(currentAppUser.ProfileImage))
                                {
                                    <button class="border-0 bg-transparent p-0" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <img src="@currentAppUser.ProfileImage" alt="Profile" class="avatar-img" />
                                    </button>
                                }
                                else
                                {
                                    <button class="avatar border-0" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        @displayInitial
                                    </button>
                                }

                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li class="px-3 py-2">
                                        <div class="fw-bold" style="color:var(--text);">@displayName</div>
                                        <small class="text-muted">@roleDisplay</small>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person me-2"></i>My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="EditProfile">
                                            <i class="bi bi-pencil-square me-2"></i>Edit Profile
                                        </a>
                                    </li>

                                    @if (User.IsInRole("Student"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Enrollment" asp-action="MyCourses">
                                                <i class="bi bi-journal-bookmark me-2"></i>My Courses
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Wishlist" asp-action="MyWishlist">
                                                <i class="bi bi-heart me-2"></i>Wishlist
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Review" asp-action="MyReviews">
                                                <i class="bi bi-star me-2"></i>My Reviews
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Instructor"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Course" asp-action="InstructorCourses">
                                                <i class="bi bi-easel2 me-2"></i>My Courses
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Course" asp-action="Create">
                                                <i class="bi bi-plus-circle me-2"></i>Create Course
                                            </a>
                                        </li>
                                    }

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                                <i class="bi bi-speedometer2 me-2"></i>Admin Panel
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Category" asp-action="Index">
                                                <i class="bi bi-grid me-2"></i>Manage Categories
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Admin" asp-action="Courses">
                                                <i class="bi bi-journal-bookmark me-2"></i>All Courses
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout"
                                              method="post" class="px-3">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-link p-0 text-danger fw-semibold"
                                                    style="font-size:.88rem;">
                                                <i class="bi bi-box-arrow-right me-1"></i>Log out
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn-outline-learnly" asp-controller="Account" asp-action="Login">Log in</a>
                            <a class="btn-primary-learnly" asp-controller="Account" asp-action="Register">Sign up</a>
                        }
                    </div>
                </div>
            </nav>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible alert-floating shadow">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible alert-floating shadow">
            <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible alert-floating shadow">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <main>@RenderBody()</main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <a class="navbar-brand-learnly mb-3" href="/">
                        <span class="brand-logo"><i class="bi bi-mortarboard-fill"></i></span>
                        Learnly
                    </a>
                    <p class="text-muted mt-2" style="font-size:.9rem;">
                        Learn new skills from industry experts. Anytime, anywhere.
                    </p>
                    <div class="mt-3">
                        <a class="social-icon" href="#"><i class="bi bi-twitter-x"></i></a>
                        <a class="social-icon" href="#"><i class="bi bi-facebook"></i></a>
                        <a class="social-icon" href="#"><i class="bi bi-instagram"></i></a>
                        <a class="social-icon" href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2">
                    <div class="footer-title">Learn</div>
                    <a class="footer-link" asp-controller="Course" asp-action="Index">All Courses</a>
                    <a class="footer-link" asp-controller="Category" asp-action="Index">Categories</a>
                    <a class="footer-link" asp-controller="Enrollment" asp-action="MyCourses">My Learning</a>
                    <a class="footer-link" asp-controller="Wishlist" asp-action="MyWishlist">Wishlist</a>
                </div>

                <div class="col-6 col-lg-2">
                    <div class="footer-title">Teach</div>
                    <a class="footer-link" asp-controller="Account" asp-action="Register">Become an Instructor</a>
                    <a class="footer-link" asp-controller="Course" asp-action="InstructorCourses">Instructor Area</a>
                    <a class="footer-link" asp-controller="Course" asp-action="Create">Create a Course</a>
                </div>

                <div class="col-lg-4">
                    <div class="footer-title">Account</div>
                    <a class="footer-link" asp-controller="Account" asp-action="Profile">My Profile</a>
                    <a class="footer-link" asp-controller="Account" asp-action="Register">Sign Up Free</a>
                    <a class="footer-link" asp-controller="Account" asp-action="Login">Log In</a>
                    <a class="footer-link" asp-controller="Account" asp-action="AccessDenied">Help</a>
                </div>
            </div>

            <hr class="my-4" style="border-color:var(--border);" />

            <div class="d-flex justify-content-between flex-wrap text-muted" style="font-size:.85rem;">
                <span>© @DateTime.Now.Year Learnly. All rights reserved.</span>
                <span>Built for learners and instructors.</span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
        var btn = document.getElementById('themeToggle');
        var icon = document.getElementById('themeIcon');

        function syncIcon() {
        var t = document.documentElement.getAttribute('data-theme');
        icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        }

        syncIcon();

        btn?.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('learnly-theme', next);
        syncIcon();
        });
        })();

        /* Language switch handled by SetCulture form POST (cookie-based) */

        setTimeout(() => {
        document.querySelectorAll('.alert-floating').forEach(a => {
        bootstrap.Alert.getOrCreateInstance(a).close();
        });
        }, 4500);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>