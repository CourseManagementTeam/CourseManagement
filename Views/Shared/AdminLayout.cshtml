@inject Microsoft.AspNetCore.Identity.UserManager<CourseManagementSystem.Models.ApplicationUser> _um
@inject Microsoft.AspNetCore.Identity.SignInManager<CourseManagementSystem.Models.ApplicationUser> _sm
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower() ?? "";
    var currentAction    = ViewContext.RouteData.Values["action"]?.ToString()?.ToLower() ?? "";
    CourseManagementSystem.Models.ApplicationUser? adminUser = null;
    string adminName = "Admin";
    string adminInitial = "A";
    if (_sm.IsSignedIn(User))
    {
        adminUser = await _um.GetUserAsync(User);
        adminName = adminUser?.FullName ?? User.Identity?.Name ?? "Admin";
        adminInitial = adminName.Length > 0 ? adminName.Substring(0, 1).ToUpper() : "A";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Learnly Admin</title>

    <script>
            (function () {
                var t = localStorage.getItem('learnly-theme') ||
                        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', t);
            })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root,
            [data-theme="light"] {
                --primary: #6d28d9;
                --primary-glow: #a78bfa;
                --sidebar-bg: #1a1633;
                --sidebar-hover: #2a2348;
                --sidebar-active: linear-gradient(135deg, #6d28d9, #a78bfa);
                --sidebar-text: #c4bce0;
                --sidebar-text-active: #ffffff;
                --bg: #f5f6fb;
                --card-bg: #ffffff;
                --topbar-bg: #ffffff;
                --text: #1e1b4b;
                --text-muted: #64748b;
                --border: #e6e8f0;
                --shadow-card: 0 2px 12px -4px rgba(30,27,75,.08);
                --sidebar-w: 260px;
                --topbar-h: 64px;
            }

            [data-theme="dark"] {
                --primary: #a78bfa;
                --primary-glow: #c4b5fd;
                --sidebar-bg: #0a0818;
                --sidebar-hover: #1a1633;
                --sidebar-active: linear-gradient(135deg, #6d28d9, #a78bfa);
                --sidebar-text: #94a3b8;
                --sidebar-text-active: #ffffff;
                --bg: #0f0c1f;
                --card-bg: #1a1633;
                --topbar-bg: #1a1633;
                --text: #f1f5f9;
                --text-muted: #94a3b8;
                --border: #2a2348;
                --shadow-card: 0 2px 12px -4px rgba(0,0,0,.5);
            }

            * {
                box-sizing: border-box;
            }

            body {
                font-family: 'Inter',system-ui,sans-serif;
                background: var(--bg);
                color: var(--text);
                margin: 0;
                -webkit-font-smoothing: antialiased;
                transition: background .25s, color .25s;
            }

            a {
                text-decoration: none;
                color: inherit;
            }

            .admin-wrapper {
                display: flex;
                min-height: 100vh;
            }

            .sidebar {
                width: var(--sidebar-w);
                background: var(--sidebar-bg);
                color: var(--sidebar-text);
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                z-index: 1040;
                display: flex;
                flex-direction: column;
                transition: transform .25s;
            }

            .sidebar-brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 1.1rem 1.4rem;
                border-bottom: 1px solid rgba(255,255,255,.06);
            }

                .sidebar-brand .logo {
                    width: 38px;
                    height: 38px;
                    border-radius: 10px;
                    background: linear-gradient(135deg,#6d28d9,#a78bfa);
                    display: grid;
                    place-items: center;
                    color: #fff;
                    box-shadow: 0 10px 25px -8px rgba(167,139,250,.55);
                }

                .sidebar-brand .brand-text {
                    color: #fff;
                    font-weight: 800;
                    font-size: 1.1rem;
                    line-height: 1;
                }

                    .sidebar-brand .brand-text small {
                        display: block;
                        font-weight: 500;
                        font-size: .68rem;
                        color: var(--primary-glow);
                        margin-top: 3px;
                        letter-spacing: 1.5px;
                    }

            .sidebar-section {
                padding: 1.2rem 1.4rem .5rem;
                font-size: .68rem;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: #6b6388;
            }

            .sidebar-nav {
                list-style: none;
                padding: 0;
                margin: 0;
                flex: 1;
                overflow-y: auto;
            }

                .sidebar-nav li {
                    padding: 0 .75rem;
                    margin-bottom: 2px;
                }

                .sidebar-nav a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: .65rem .85rem;
                    border-radius: 10px;
                    color: var(--sidebar-text);
                    font-size: .92rem;
                    font-weight: 500;
                    transition: all .15s;
                }

                    .sidebar-nav a:hover {
                        background: var(--sidebar-hover);
                        color: #fff;
                    }

                    .sidebar-nav a.active {
                        background: var(--sidebar-active);
                        color: var(--sidebar-text-active);
                        box-shadow: 0 8px 20px -8px rgba(167,139,250,.6);
                    }

                    .sidebar-nav a i {
                        font-size: 1.1rem;
                        width: 22px;
                        text-align: center;
                    }

            .sidebar-footer {
                padding: 1rem 1.4rem;
                border-top: 1px solid rgba(255,255,255,.06);
                font-size: .8rem;
                color: #6b6388;
            }

            .main-area {
                flex: 1;
                margin-left: var(--sidebar-w);
                display: flex;
                flex-direction: column;
                min-width: 0;
            }

            .topbar {
                height: var(--topbar-h);
                background: var(--topbar-bg);
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                padding: 0 1.5rem;
                position: sticky;
                top: 0;
                z-index: 1020;
            }

                .topbar .sidebar-toggle {
                    display: none;
                    border: none;
                    background: transparent;
                    font-size: 1.4rem;
                    color: var(--text);
                    margin-right: .5rem;
                }

            .page-title {
                font-size: 1.05rem;
                font-weight: 700;
                margin: 0;
                color: var(--text);
            }

            .topbar-search {
                position: relative;
                max-width: 340px;
                margin-left: 1.5rem;
                flex: 1;
            }

                .topbar-search i {
                    position: absolute;
                    left: 12px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-muted);
                }

                .topbar-search input {
                    width: 100%;
                    padding: .5rem .9rem .5rem 2.2rem;
                    border: 1px solid var(--border);
                    border-radius: 10px;
                    background: var(--bg);
                    color: var(--text);
                    font-size: .88rem;
                }

                    .topbar-search input:focus {
                        outline: none;
                        border-color: var(--primary-glow);
                        background: var(--card-bg);
                    }

            .topbar-actions {
                margin-left: auto;
                display: flex;
                align-items: center;
                gap: 4px;
            }

                .topbar-actions .icon-btn {
                    position: relative;
                    width: 40px;
                    height: 40px;
                    display: grid;
                    place-items: center;
                    border: none;
                    background: transparent;
                    color: var(--text-muted);
                    border-radius: 10px;
                }

                    .topbar-actions .icon-btn:hover {
                        background: var(--bg);
                        color: var(--primary);
                    }

                    .topbar-actions .icon-btn .dot {
                        position: absolute;
                        top: 9px;
                        right: 10px;
                        width: 8px;
                        height: 8px;
                        background: #ef4444;
                        border: 2px solid var(--topbar-bg);
                        border-radius: 50%;
                    }

                .topbar-actions .view-site {
                    font-size: .85rem;
                    font-weight: 600;
                    color: var(--primary);
                    padding: .45rem .9rem;
                    border-radius: 10px;
                }

                    .topbar-actions .view-site:hover {
                        background: var(--bg);
                    }

            .avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: linear-gradient(135deg,#6d28d9,#a78bfa);
                color: #fff;
                display: grid;
                place-items: center;
                font-weight: 700;
                font-size: .9rem;
                cursor: pointer;
            }

            .content {
                padding: 1.75rem;
                flex: 1;
            }

            .stat-card {
                background: var(--card-bg);
                border-radius: 14px;
                padding: 1.25rem;
                border: 1px solid var(--border);
                box-shadow: var(--shadow-card);
            }

                .stat-card .label {
                    color: var(--text-muted);
                    font-size: .82rem;
                    font-weight: 500;
                }

                .stat-card .value {
                    font-size: 1.65rem;
                    font-weight: 800;
                    margin-top: .25rem;
                    color: var(--text);
                }

                .stat-card .delta {
                    font-size: .78rem;
                    font-weight: 600;
                }

                .stat-card .icon-box {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    display: grid;
                    place-items: center;
                    font-size: 1.25rem;
                }

            .card-elegant {
                background: var(--card-bg);
                border-radius: 14px;
                border: 1px solid var(--border);
                box-shadow: var(--shadow-card);
                color: var(--text);
            }

            .btn-primary-admin {
                background: linear-gradient(135deg,#6d28d9,#a78bfa);
                border: none;
                color: #fff;
                font-weight: 600;
                padding: .5rem 1.1rem;
                border-radius: 10px;
                box-shadow: 0 8px 20px -8px rgba(109,40,217,.4);
            }

                .btn-primary-admin:hover {
                    color: #fff;
                    opacity: .92;
                }

            .dropdown-menu {
                background: var(--card-bg);
                border: 1px solid var(--border);
                color: var(--text);
            }

            .dropdown-item {
                color: var(--text);
            }

                .dropdown-item:hover {
                    background: var(--bg);
                    color: var(--primary);
                }

            .alert-floating {
                position: fixed;
                top: calc(var(--topbar-h) + 14px);
                right: 24px;
                z-index: 1050;
                min-width: 280px;
            }

            .sidebar-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.4);
                z-index: 1035;
            }

            @@media (max-width: 991.98px) {
                .sidebar {
                    transform: translateX(-100%);
                }

                    .sidebar.show {
                        transform: translateX(0);
                    }

                .sidebar-backdrop.show {
                    display: block;
                }

                .main-area {
                    margin-left: 0;
                }

                .topbar .sidebar-toggle {
                    display: inline-grid;
                }

                .topbar-search {
                    display: none;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-wrapper">
        <aside class="sidebar" id="adminSidebar">
            <div class="sidebar-brand">
                <div class="logo"><i class="bi bi-mortarboard-fill"></i></div>
                <div class="brand-text">Learnly<small>ADMIN PANEL</small></div>
            </div>

            <div class="sidebar-section">Main</div>
            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="Admin" asp-action="Index"
                       class="@(currentController == "admin" && currentAction == "index" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Courses"
                       class="@(currentController == "admin" && currentAction == "courses" ? "active" : "")">
                        <i class="bi bi-journal-bookmark"></i> Courses
                    </a>
                </li>
                <li>
                    <a asp-controller="Category" asp-action="Index"
                       class="@(currentController == "category" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i> Categories
                    </a>
                </li>
            </ul>

            <div class="sidebar-section">People</div>
            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="Admin" asp-action="Users"
                       class="@(currentController == "admin" && currentAction == "users" ? "active" : "")">
                        <i class="bi bi-people"></i> Users
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Enrollments"
                       class="@(currentController == "admin" && currentAction == "enrollments" ? "active" : "")">
                        <i class="bi bi-mortarboard"></i> Enrollments
                    </a>
                </li>
            </ul>

            <div class="sidebar-section">Engagement</div>
            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="Admin" asp-action="Reviews"
                       class="@(currentController == "admin" && currentAction == "reviews" ? "active" : "")">
                        <i class="bi bi-star"></i> Reviews
                    </a>
                </li>
            </ul>

            <div class="sidebar-section">System</div>
            <ul class="sidebar-nav">
                <li><a href="/"><i class="bi bi-box-arrow-left"></i> Back to Site</a></li>
            </ul>

            <div class="sidebar-footer">
                <i class="bi bi-circle-fill text-success me-2" style="font-size:.55rem;"></i>
                All systems operational
            </div>
        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="main-area">
            <header class="topbar">
                <button class="sidebar-toggle" id="sidebarToggle"><i class="bi bi-list"></i></button>
                <h1 class="page-title">@(ViewData["Title"] ?? "Dashboard")</h1>

                <div class="topbar-search">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="Search admin..." />
                </div>

                <div class="topbar-actions">
                    <a class="view-site" href="/"><i class="bi bi-box-arrow-up-right me-1"></i> View site</a>

                    <!-- THEME TOGGLE -->
                    <button id="themeToggle" class="icon-btn" type="button" title="Toggle theme">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                    </button>

                    <button class="icon-btn"><i class="bi bi-bell"></i><span class="dot"></span></button>
                    <button class="icon-btn"><i class="bi bi-envelope"></i></button>

                    <div class="dropdown ms-2">
                        <div class="avatar" data-bs-toggle="dropdown">@(adminName.Substring(0, 1).ToUpper())</div>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li class="px-3 py-2">
                                <div class="fw-bold">@adminName</div>
                                <small class="text-muted">Administrator</small>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="/Profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><a class="dropdown-item" href="/AdminSettings"><i class="bi bi-gear me-2"></i>Settings</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                    <button type="submit" class="btn btn-link p-0 text-danger">Log out</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible alert-floating shadow">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible alert-floating shadow">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <main class="content">@RenderBody()</main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sb = document.getElementById('adminSidebar');
        const bd = document.getElementById('sidebarBackdrop');
        document.getElementById('sidebarToggle')?.addEventListener('click', () => { sb.classList.add('show'); bd.classList.add('show'); });
        bd?.addEventListener('click', () => { sb.classList.remove('show'); bd.classList.remove('show'); });

        (function () {
        var btn = document.getElementById('themeToggle');
        var icon = document.getElementById('themeIcon');
        function syncIcon() {
        var t = document.documentElement.getAttribute('data-theme');
        icon.className = t === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
        }
        syncIcon();
        btn?.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        var next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('learnly-theme', next);
        syncIcon();
        });
        })();

        setTimeout(() => {
        document.querySelectorAll('.alert-floating').forEach(a => {
        bootstrap.Alert.getOrCreateInstance(a).close();
        });
        }, 4500);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>


