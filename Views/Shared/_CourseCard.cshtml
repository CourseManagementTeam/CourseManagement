@model CourseManagementSystem.Models.Course

<div class="col-sm-6 col-md-4 col-lg-3">
    <div class="card h-100 border-0 course-card position-relative"
         style="background:var(--card-bg);border:1px solid var(--border)!important;box-shadow:var(--shadow-card);border-radius:14px;overflow:hidden;">

        <div class="course-thumb position-relative overflow-hidden" style="height:180px;">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                     ? "/images/Courses/default.avif"
                     : $"/images/Courses/{Model.ImageUrl}")"
                 class="w-100 h-100"
                 style="object-fit:cover;transition:transform .4s ease;"
                 alt="@Model.Title"
                 onerror="this.src='/images/Courses/default.avif'">
            <span class="badge position-absolute top-0 end-0 m-2 px-2 py-1"
                  style="background:var(--card-bg);color:var(--primary);font-weight:700;font-size:.78rem;border:1px solid var(--border);border-radius:8px;">
                @(Model.Price == 0 ? "Free" : Model.Price.ToString("C", new System.Globalization.CultureInfo("en-US")))
            </span>
            @if (Model.Level != null)
            {
                <span class="badge position-absolute bottom-0 start-0 m-2 px-2 py-1"
                      style="background:rgba(0,0,0,.55);color:#fff;font-size:.72rem;border-radius:6px;backdrop-filter:blur(4px);">
                    @Model.Level
                </span>
            }
        </div>

        <div class="card-body d-flex flex-column p-3">
            <small class="fw-bold text-uppercase mb-1" style="color:var(--primary);font-size:.7rem;letter-spacing:.04em;">
                @(Model.Category?.Name ?? "General")
            </small>

            <h6 class="fw-bold mb-2 lh-sm"
                style="color:var(--text);overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;min-height:2.8rem;">
                @Model.Title
            </h6>

            <p class="mb-2" style="font-size:.8rem;color:var(--text-muted);">
                <i class="bi bi-person-circle me-1"></i>@(Model.Instructor?.FullName ?? "Expert Instructor")
            </p>

            <div class="d-flex align-items-center gap-1 mb-3 mt-auto">
                <span style="color:#f59e0b;font-size:.85rem;font-weight:700;">★ @Model.AverageRating.ToString("0.0")</span>
                <span style="color:var(--text-muted);font-size:.78rem;">(@Model.ReviewsCount)</span>
            </div>

            <a asp-controller="Course"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-sm w-100 stretched-link fw-semibold"
               style="background:transparent;border:1.5px solid var(--primary);color:var(--primary);border-radius:8px;padding:.4rem;font-size:.83rem;transition:all .15s;">
                View Course
            </a>
        </div>
    </div>
</div>

<style>
    .course-card { transition: transform .22s, box-shadow .22s; }
    .course-card:hover { transform: translateY(-4px); box-shadow: 0 12px 28px -8px rgba(109,40,217,.28) !important; }
    .course-card:hover .course-thumb img { transform: scale(1.04); }
</style>