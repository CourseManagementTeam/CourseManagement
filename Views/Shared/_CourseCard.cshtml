@model CourseManagementSystem.Models.Course

<div class="col-sm-6 col-md-4 col-lg-3">
    <div class="card h-100 border-0 course-card position-relative" style="background: var(--card-bg); border: 1px solid var(--border) !important; box-shadow: var(--shadow-card);">

        <span class="badge bg-dark position-absolute top-0 start-0 m-3 fs-6">
            @(Model.Price == 0 ? "Free" : $"${Model.Price}")
        </span>

        <img src="@(string.IsNullOrEmpty(Model.ImageUrl)
                 ? "/images/courses/default.jpg"
                 : $"/images/courses/{Model.ImageUrl}")"
             class="card-img-top object-fit-cover"
             style="height:180px;"
             alt="@Model.Title">
        <div class="card-body d-flex flex-column p-3">
            <small class="text-primary fw-bold text-uppercase mb-1">@Model.Category?.Name</small>

            <h5 class="card-title fw-bold mb-2 text-dark text-truncate-2" style="height: 3rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                @Model.Title
            </h5>

            <p class="card-text text-muted small mb-2">By: @(Model.Instructor?.UserName ?? "Expert Instructor")</p>

            <div class="d-flex align-items-center gap-1 mb-3 mt-auto">
                <span class="text-warning fw-bold small">★ @Model.AverageRating.ToString("0.0")</span>
                <span class="text-muted small">(@Model.ReviewsCount reviews)</span>
            </div>

            <a asp-controller="Course"
               asp-action="Details"
               asp-route-id="@Model.Id"
                class="btn btn-outline-primary btn-sm w-100 stretched-link">
                View Details
            </a>
        </div>
    </div>
</div>

<style>
    .course-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .course-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
    }
</style>