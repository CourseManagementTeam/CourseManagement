@model CourseManagementSystem.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-5">
    <div class="card shadow border-0 mx-auto" style="max-width:700px;">
        <div class="card-body p-4">
            <h2 class="mb-4">Create Category</h2>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g., Web Development" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Describe this category..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success px-4">Save</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </form>
        </div>
    </div>
</div>