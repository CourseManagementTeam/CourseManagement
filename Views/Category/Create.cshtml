@model CourseManagementSystem.Models.Category

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width:700px; background: var(--card-bg);">
        <div class="card-body p-4">

            <h2 class="mb-1 fw-bold" style="color: var(--text);">
                <i class="bi bi-grid-1x2 me-2" style="color: var(--primary);"></i>New Category
            </h2>
            <p class="text-muted mb-4" style="font-size:.9rem;">Add a new educational branch to Learnly.</p>

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: var(--text);">Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Web Development" />
                    <span asp-validation-for="Name" class="text-danger" style="font-size:.85rem;"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold" style="color: var(--text);">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of this category..."></textarea>
                    <span asp-validation-for="Description" class="text-danger" style="font-size:.85rem;"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Category
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>

            </form>

        </div>
    </div>
</div>