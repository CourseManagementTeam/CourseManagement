@model IEnumerable<CourseManagementSystem.Models.Category>

@{
    ViewData["Title"] = "Categories Admin";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="fw-extrabold">Categories Setup</h1>
            <p class="text-muted mb-0">Organize and manage the core educational branches of Learnly.</p>
        </div>
        <a class="btn btn-primary-learnly" asp-action="Create">+ Add New Category</a>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm p-4" style="background: var(--card-bg); border-radius: 16px; border: 1px solid var(--border) !important;">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="brand-logo" style="width: 44px; height: 44px;">
                            <i class="bi bi-grid-1x2-fill"></i>
                        </div>

                        <span class="badge bg-primary-soft rounded-pill text-primary px-3 py-2 fw-semibold">
                            <i class="bi bi-book me-1"></i> @(item.Courses?.Count ?? 0) Courses
                        </span>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical fs-5"></i></button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil me-2 text-warning"></i>Edit</a></li>
                                <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id"><i class="bi bi-trash me-2"></i>Delete</a></li>
                            </ul>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-2">@item.Name</h5>
                    <p class="text-muted small mb-4 text-truncate-3" style="line-height: 1.5; min-height: 4.5rem;">@item.Description</p>

                    <div class="mt-auto pt-3 d-flex justify-content-between align-items-center" style="border-top: 1px solid var(--border);">
                        <span class="text-xs text-muted fw-medium"><i class="bi bi-book-half me-1"></i> Managed Branch</span>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill">Details</a>
                    </div>
                </div>
                @* <div class="card h-100 border-0 shadow-sm p-4" style="background: var(--card-bg); border-radius: 16px; border: 1px solid var(--border) !important;">
                    <div class="d-flex align-items-start justify-content-between mb-3">
