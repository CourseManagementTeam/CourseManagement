@model IEnumerable<CourseManagementSystem.Models.Section>

@{
    ViewData["Title"] = "Manage Curriculum";
    int courseId    = ViewBag.CourseId;
    string courseTitle = ViewBag.CourseTitle ?? "Course";
    int totalSections = Model.Count();
    int totalLessons  = Model.Sum(s => s.Lessons?.Count ?? 0);
    int totalMinutes  = Model.Sum(s => s.Lessons?.Sum(l => l.DurationMinutes) ?? 0);
}

<div class="container py-5">

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <a asp-controller="Course" asp-action="InstructorCourses"
               class="text-muted text-decoration-none d-inline-flex align-items-center gap-1 mb-2"
               style="font-size:.85rem;">
                <i class="bi bi-arrow-left"></i> Back to My Courses
            </a>
            <h2 class="fw-bold mb-1" style="color:var(--text);">
                <i class="bi bi-list-ul me-2" style="color:var(--primary);"></i>Curriculum Builder
            </h2>
            <p class="text-muted mb-0" style="font-size:.9rem;">@courseTitle</p>
        </div>
        <a asp-action="Create" asp-route-courseId="@courseId" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Section
        </a>
    </div>

    @* Stats bar *@
    <div class="d-flex gap-4 mb-4 p-3 rounded-3" style="background:var(--card-bg); border:1px solid var(--border); font-size:.88rem;">
        <span style="color:var(--text);"><i class="bi bi-collection me-1" style="color:var(--primary);"></i><strong>@totalSections</strong> Sections</span>
        <span style="color:var(--text);"><i class="bi bi-play-circle me-1" style="color:var(--primary);"></i><strong>@totalLessons</strong> Lessons</span>
        <span style="color:var(--text);"><i class="bi bi-clock me-1" style="color:var(--primary);"></i>
            <strong>@(totalMinutes >= 60 ? $"{totalMinutes / 60}h {totalMinutes % 60}m" : $"{totalMinutes}m")</strong> Total
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5" style="background:var(--card-bg); border-radius:16px; border:1px dashed var(--border);">
            <i class="bi bi-collection" style="font-size:3rem; color:var(--primary); opacity:.4;"></i>
            <h5 class="mt-3 fw-semibold" style="color:var(--text);">No sections yet</h5>
            <p class="text-muted">Add your first section to start building the course curriculum.</p>
            <a asp-action="Create" asp-route-courseId="@courseId" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Add First Section
            </a>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var sec in Model)
            {
                var lessons = sec.Lessons?.OrderBy(l => l.OrderNumber).ToList() ?? new();
                <div class="card border-0 shadow-sm" style="background:var(--card-bg); border-radius:14px; overflow:hidden;">

                    @* Section header *@
                    <div class="d-flex align-items-center justify-content-between px-4 py-3"
                         style="border-bottom:1px solid var(--border); background:var(--bg);">
                        <div class="d-flex align-items-center gap-3">
                            <div class="fw-bold" style="color:var(--primary); font-size:.8rem; min-width:22px;">
                                @sec.OrderNumber
                            </div>
                            <div>
                                <span class="fw-semibold" style="color:var(--text);">@sec.Title</span>
                                <span class="text-muted ms-2" style="font-size:.8rem;">
                                    @lessons.Count lesson@(lessons.Count == 1 ? "" : "s")
                                    @{
                                        var secMin = lessons.Sum(l => l.DurationMinutes);
                                    }
                                    @if (secMin > 0)
                                    {
                                        <text> · @(secMin >= 60 ? $"{secMin / 60}h {secMin % 60}m" : $"{secMin}m")</text>
                                    }
                                </span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-controller="Lesson" asp-action="Create" asp-route-sectionId="@sec.Id"
                               class="btn btn-sm btn-primary" title="Add Lesson">
                                <i class="bi bi-plus me-1"></i>Lesson
                            </a>
                            <a asp-action="Edit" asp-route-id="@sec.Id"
                               class="btn btn-sm btn-outline-warning" title="Edit Section">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@sec.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete section and all its lessons?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Section">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    @* Lessons list *@
                    @if (!lessons.Any())
                    {
                        <div class="px-4 py-3 text-muted" style="font-size:.85rem;">
                            <i class="bi bi-info-circle me-1"></i> No lessons yet.
                            <a asp-controller="Lesson" asp-action="Create" asp-route-sectionId="@sec.Id"
                               style="color:var(--primary);">Add the first lesson</a>
                        </div>
                    }
                    else
                    {
                        @foreach (var lesson in lessons)
                        {
                            <div class="d-flex align-items-center justify-content-between px-4 py-3"
                                 style="border-bottom:1px solid var(--border);">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="text-muted" style="font-size:.78rem; min-width:20px;">@lesson.OrderNumber</span>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="fw-semibold" style="color:var(--text); font-size:.9rem;">@lesson.Title</span>
                                            @if (lesson.IsFreePreview)
                                            {
                                                <span class="badge" style="background:#dcfce7; color:#166534; font-size:.7rem;">Free Preview</span>
                                            }
                                            @if (!string.IsNullOrEmpty(lesson.VideoType))
                                            {
                                                <span class="badge" style="background:#ede9fe; color:#6d28d9; font-size:.7rem;">
                                                    <i class="bi bi-camera-video me-1"></i>@lesson.VideoType
                                                </span>
                                            }
                                            @{
                                                var attCount = lesson.Attachments?.Count ?? 0;
                                            }
                                            @if (attCount > 0)
                                            {
                                                <span class="badge" style="background:#fef3c7; color:#92400e; font-size:.7rem;">
                                                    <i class="bi bi-paperclip me-1"></i>@attCount file@(attCount == 1 ? "" : "s")
                                                </span>
                                            }
                                        </div>
                                        @if (lesson.DurationMinutes > 0)
                                        {
                                            <span class="text-muted" style="font-size:.78rem;">
                                                <i class="bi bi-clock me-1"></i>
                                                @(lesson.DurationMinutes >= 60
                                                    ? $"{lesson.DurationMinutes / 60}h {lesson.DurationMinutes % 60}m"
                                                    : $"{lesson.DurationMinutes}m")
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex gap-2 flex-shrink-0">
                                    <a asp-controller="Lesson" asp-action="Edit" asp-route-id="@lesson.Id"
                                       class="btn btn-sm btn-outline-warning" title="Edit Lesson">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-controller="Lesson" asp-action="Delete" asp-route-id="@lesson.Id"
                                       class="btn btn-sm btn-outline-danger" title="Delete Lesson">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        }
                        <div class="px-4 py-2" style="font-size:.83rem;">
                            <a asp-controller="Lesson" asp-action="Create" asp-route-sectionId="@sec.Id"
                               style="color:var(--primary); text-decoration:none;">
                                <i class="bi bi-plus-circle me-1"></i> Add another lesson
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>
